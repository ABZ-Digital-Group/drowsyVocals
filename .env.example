PORT=3000
NODE_ENV=production
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_TLS=true
# Temporary emergency exception only for a self-hosted MongoDB server without TLS.
MONGODB_ALLOW_INSECURE=false
SESSION_SECRET=
BOT_API_URL=https://bot-api.drowsyvocals.com
BOT_API_SECRET=
BOT_PASSWORD_RESET_DM_PATH=/actions/direct-message
# Optional: separate secret for DrowsyBot voice-session ingestion. Defaults to BOT_API_SECRET.
VOICE_ACTIVITY_API_SECRET=
PASSWORD_RESET_TOKEN_TTL_MINUTES=20
PASSWORD_RESET_URL_BASE=
DROWSY_BOT_DIR=
