<!DOCTYPE html>
<html lang="en">
    <head><%- include('../partials/head') %><title>Private Check-ins</title></head>
    <body>
        <header><%- include('../partials/nav') %></header>
        <main>
            <section class="profile-page check-ins-page">
                <div class="profile-heading">
                    <p class="profile-eyebrow">Private Member Records</p>
                    <h1>Check-ins</h1>
                    <p class="profile-subtitle">Meeting notes connected to one member's record.</p>
                </div>

                <% if (canSelectUser) { %>
                <form class="check-in-selector" method="GET" action="/check-ins">
                    <label for="checkInUser">Member</label>
                    <select id="checkInUser" name="user" required>
                        <option value="">Select a member</option>
                        <% users.forEach(function(user) { %>
                        <% const userId = user.login?.discordId; %>
                        <% if (userId) { %>
                        <option value="<%= userId %>" <%= userId === targetUser.login?.discordId ? 'selected' : '' %>>
                            <%= user.displayName || user.discordUser || userId %> (<%= user.accountType || 'Member' %>)
                        </option>
                        <% } %>
                        <% }); %>
                    </select>
                    <button class="action-button action-button-secondary" type="submit"><span class="material-symbols-outlined" aria-hidden="true">person_search</span>View record</button>
                </form>
                <% } %>

                <form class="check-in-filters" method="GET" action="/check-ins">
                    <input type="hidden" name="user" value="<%= targetUser.login.discordId %>">
                    <label for="checkInSearch">Search notes</label>
                    <input id="checkInSearch" type="search" name="q" value="<%= searchQuery || '' %>" placeholder="Search notes, authors, or follow-ups">
                    <select name="followUp" aria-label="Follow-up filter">
                        <option value="">All follow-ups</option>
                        <option value="open" <%= followUpFilter === 'open' ? 'selected' : '' %>>Open follow-ups</option>
                        <option value="complete" <%= followUpFilter === 'complete' ? 'selected' : '' %>>Completed follow-ups</option>
                    </select>
                    <button class="action-button action-button-secondary" type="submit"><span class="material-symbols-outlined" aria-hidden="true">filter_alt</span>Filter</button>
                </form>

                <div class="check-in-record-header">
                    <div>
                        <p class="profile-eyebrow">Selected record</p>
                        <h2><%= targetUser.displayName || targetUser.discordUser || targetUser.login.discordId %></h2>
                        <p><%= targetUser.accountType || 'Member' %> · <%= targetUser.login?.discordId %></p>
                    </div>
                    <span class="material-symbols-outlined check-in-lock" title="Private record" aria-label="Private record">lock</span>
                </div>

                <% if (canCreate) { %>
                <form class="check-in-form" method="POST" action="/check-ins" enctype="multipart/form-data">
                    <input type="hidden" name="targetDiscordId" value="<%= targetUser.login.discordId %>">
                    <label for="checkInTemplate">Template</label>
                    <select id="checkInTemplate">
                        <% checkInTemplates.forEach(function(template) { %><option value="<%= template.note %>"><%= template.name %></option><% }); %>
                        </select>
                    <label for="checkInNote">Meeting note</label>
                    <textarea id="checkInNote" name="note" rows="6" maxlength="5000" placeholder="Record what was discussed and any follow-up actions..." required></textarea>
                    <label for="checkInVisibility">Who can view this note?</label>
                    <select id="checkInVisibility" name="visibility">
                        <option value="all">All authenticated users</option>
                        <option value="staff">Selected staff only</option>
                        <option value="gods">Gods and developers only</option>
                    </select>
                    <label for="checkInVisibleUsers">Selected staff</label>
                    <select id="checkInVisibleUsers" name="visibleUserIds" multiple size="4">
                        <% users.forEach(function(user) { %>
                        <% if (user.login?.discordId) { %><option value="<%= user.login.discordId %>"><%= user.displayName || user.discordUser || user.login.discordId %></option><% } %>
                        <% }); %>
                    </select>
                    <label for="followUpText">Follow-up action</label>
                    <input id="followUpText" name="followUpText" maxlength="1000" placeholder="Optional action to complete">
                    <label for="followUpDueDate">Follow-up due date</label>
                    <input id="followUpDueDate" name="followUpDueDate" type="date">
                    <label for="checkInAttachment">Attachment</label>
                    <input id="checkInAttachment" name="attachment" type="file" accept="image/png,image/jpeg,image/webp,application/pdf,text/plain">
                    <button class="action-button action-button-primary" type="submit"><span class="material-symbols-outlined" aria-hidden="true">add_comment</span>Add check-in note</button>
                </form>
                <% } %>

                <div class="check-in-notes">
                    <div class="check-in-notes-heading">
                        <h2>Meeting notes</h2>
                        <span><%= checkIns.length %> note<%= checkIns.length === 1 ? '' : 's' %></span>
                    </div>
                    <% if (!checkIns.length) { %>
                    <p class="check-in-empty">No check-in notes have been recorded for this member.</p>
                    <% } else { %>
                    <% checkIns.forEach(function(checkIn) { %>
                    <article class="check-in-note">
                        <div class="check-in-note-meta">
                            <strong><%= checkIn.authorDisplayName || checkIn.authorDiscordId %></strong>
                            <time datetime="<%= checkIn.createdAt %>"><%= new Date(checkIn.createdAt).toLocaleString() %></time>
                        </div>
                        <p><%= checkIn.note %></p>
                        <div class="check-in-note-details">
                            <span class="check-in-visibility"><span class="material-symbols-outlined" aria-hidden="true">visibility</span><%= checkIn.visibility === 'gods' ? 'Gods and developers only' : checkIn.visibility === 'staff' ? 'Selected staff only' : 'All authenticated users' %></span>
                            <% if (checkIn.followUpText) { %>
                            <span class="check-in-follow-up <%= checkIn.followUpComplete ? 'is-complete' : '' %>"><strong>Follow-up:</strong> <%= checkIn.followUpText %><%= checkIn.followUpDueDate ? ` · due ${checkIn.followUpDueDate}` : '' %></span>
                            <form method="POST" action="/check-ins/<%= checkIn._id %>/follow-up">
                                <input type="hidden" name="completed" value="<%= checkIn.followUpComplete ? 'false' : 'true' %>">
                                <button class="action-button action-button-secondary" type="submit"><span class="material-symbols-outlined" aria-hidden="true"><%= checkIn.followUpComplete ? 'restart_alt' : 'task_alt' %></span><%= checkIn.followUpComplete ? 'Reopen' : 'Complete' %></button>
                            </form>
                            <% } %>
                            <% (checkIn.attachments || []).forEach(function(attachment) { %><a href="/check-ins/<%= checkIn._id %>/attachment/<%= encodeURIComponent(attachment.filename) %>" target="_blank" rel="noreferrer"><span class="material-symbols-outlined" aria-hidden="true">attach_file</span><%= attachment.originalName %></a><% }); %>
                        </div>
                        <% if (canCreate) { %>
                        <details class="check-in-edit">
                            <summary><span class="material-symbols-outlined" aria-hidden="true">edit</span> Edit note</summary>
                            <form method="POST" action="/check-ins/<%= checkIn._id %>/edit">
                                <input type="hidden" name="targetDiscordId" value="<%= targetUser.login.discordId %>">
                                <textarea name="note" rows="4" maxlength="5000" required><%= checkIn.note %></textarea>
                                <button class="action-button action-button-secondary" type="submit"><span class="material-symbols-outlined" aria-hidden="true">save</span>Save edit</button>
                            </form>
                            <form method="POST" action="/check-ins/<%= checkIn._id %>/delete" onsubmit="return confirm('Delete this check-in note?');">
                                <input type="hidden" name="targetDiscordId" value="<%= targetUser.login.discordId %>">
                                <button class="action-button action-button-danger" type="submit"><span class="material-symbols-outlined" aria-hidden="true">delete</span>Delete note</button>
                            </form>
                        </details>
                        <% } %>
                        <% if ((checkIn.editHistory || []).length) { %>
                        <details class="check-in-history"><summary>View edit history (<%= checkIn.editHistory.length %>)</summary><ul><% checkIn.editHistory.slice().reverse().forEach(function(edit) { %><li><time><%= new Date(edit.editedAt).toLocaleString() %></time> by <%= edit.editedBy %><p><%= edit.note %></p></li><% }); %></ul></details>
                        <% } %>
                    </article>
                    <% }); %>
                    <% } %>
                </div>
            </section>
        </main>
        <div class="footer"><p>&copy; 2026 Drowsy Vocals | All rights reserved.</p></div>
        <script>
            const templateSelect = document.getElementById('checkInTemplate');
            const noteField = document.getElementById('checkInNote');
            if (templateSelect && noteField) templateSelect.addEventListener('change', () => { if (!noteField.value.trim()) noteField.value = templateSelect.value; });
        </script>
    </body>
</html>
