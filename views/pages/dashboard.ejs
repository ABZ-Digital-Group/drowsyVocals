<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Dashboard</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="dashboard-content">
                <h1><span id="time-greeting"></span> <%= currentDisplayName %></h1>
                <p>Here you can manage your account, view your roster, and access online coaching resources.</p>
            </section>

            <section class="profile-page">
                <% if (announcements.length) { %><div class="dashboard-announcements"><span>Announcements</span><% announcements.forEach(function(item) { %><article><p><% if (item.pinned) { %><span class="announcement-pin">Pinned</span><% } %> <%= item.content %></p><div class="announcement-meta"><small><%= item.createdByName %> · <%= (item.createdAt || '').slice(0, 10) %><%= item.expiresAt ? ` · Expires ${item.expiresAt}` : '' %></small><% if (staffSummary) { %><div class="announcement-actions"><form action="/announcements/<%= item._id %>/pin" method="POST"><input type="hidden" name="pinned" value="<%= item.pinned ? 'false' : 'true' %>"><button type="submit"><%= item.pinned ? 'Unpin' : 'Pin' %></button></form><form action="/announcements/<%= item._id %>/delete" method="POST" onsubmit="return confirm('Remove this announcement?');"><button type="submit">Remove</button></form></div><% } %></div></article><% }); %></div><% } %>
                <div class="profile-details">
                    <div class="profile-detail">
                        <span>Rank</span>
                        <strong><%= accountType || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>House</span>
                        <strong><%= house || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>House Points</span>
                        <strong><%= housePoints ?? 0 %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Activity</span>
                        <strong><%= activity || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Total Strikes</span>
                        <strong><%= totalStrikes %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>This Week's Meeting</span>
                        <strong><%= attendedThisWeek ? 'Attended' : 'Not marked yet' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Your Pending LOA Requests</span>
                        <strong><%= pendingLoaCount %></strong>
                    </div>
                </div>
            </section>

            <% if (staffSummary) { %>
            <section class="dashboard-widgets"><a href="/loa"><strong><%= pendingLoaTotal %></strong><span>Pending LOA requests</span></a><a href="/feedback"><strong><%= notifications.length %></strong><span>Open management notifications</span></a><a href="/audit-log"><span>View</span><strong>Recent audit activity</strong></a></section>
            <form class="announcement-form" action="/announcements" method="POST"><label for="announcementContent">Post announcement</label><textarea id="announcementContent" name="content" rows="2" maxlength="1000" required></textarea><label>Expiry date (optional)<input type="date" name="expiresAt"></label><label class="checkbox-label"><input type="checkbox" name="pinned" value="true"> Pin announcement</label><button type="submit">Publish</button></form>
            <section class="roster-content">
                <h2>Staff Overview</h2>
                <div class="roster-stats">
                    <div>
                        <p>Total Staff: <%= staffSummary.total %></p>
                    </div>
                    <div>
                        <p>Active Staff: <%= staffSummary.active %></p>
                    </div>
                    <div>
                        <p>Semi-Active Staff: <%= staffSummary.semiActive %></p>
                    </div>
                    <div>
                        <p>LOA: <%= staffSummary.loa %></p>
                    </div>
                    <div>
                        <p>Inactive Staff: <%= staffSummary.inactive %></p>
                    </div>
                    <div>
                        <p>Pending LOA Requests: <%= pendingLoaTotal %></p>
                    </div>
                </div>
                <div class="dashboard-actions">
                    <button class="action-button action-button-primary" type="button" onclick="window.location.href='/reports'">
                        <span class="material-symbols-outlined" aria-hidden="true">summarize</span>
                        Generate Weekly Report
                    </button>
                </div>
            </section>
            <% } %>

        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const greetingSpan = document.getElementById('time-greeting');
            const currentHour = new Date().getHours();
            let greeting = 'Good evening'; // Default greeting

            if (currentHour < 12) {
                greeting = 'Good morning';
            } else if (currentHour < 18) {
                greeting = 'Good afternoon';
            }

            greetingSpan.textContent = greeting;
        });
    </script>
    </body>
</html>
