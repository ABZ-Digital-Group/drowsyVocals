<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Dashboard</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="dashboard-content">
                <h1><span id="time-greeting"></span> <%= currentDisplayName %></h1>
                <p>Here you can manage your account, view your roster, and access online coaching resources.</p>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const greetingSpan = document.getElementById('time-greeting');
            const currentHour = new Date().getHours();
            let greeting = 'Good evening'; // Default greeting

            if (currentHour < 12) {
                greeting = 'Good morning';
            } else if (currentHour < 18) {
                greeting = 'Good afternoon';
            }

            greetingSpan.textContent = greeting;
        });
    </script>
    </body>
</html>