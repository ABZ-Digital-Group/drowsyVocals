<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/main.css">
        <title>Drowsy Dashboard</title>
    </head>
    <body>
        <header>
            <!-- <nav>
                <img src="/assets/DrowsyLogo.png" alt="Drowsy Vocals Logo">
                <ul>
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/roster">Roster</a></li>
                    <li><a href="/contact">Account</a></li>
                    <li><a href="/logout">Logout</a></li>
                </ul>
            </nav> -->
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="dashboard-content">
                <h1><span id="time-greeting"></span> <%= currentuser %></h1>
                <p>Here you can manage your account, view your roster, and access online coaching resources.</p>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const greetingSpan = document.getElementById('time-greeting');
            const currentHour = new Date().getHours();
            let greeting = 'Good evening'; // Default greeting

            if (currentHour < 12) {
                greeting = 'Good morning';
            } else if (currentHour < 18) {
                greeting = 'Good afternoon';
            }

            greetingSpan.textContent = greeting;
        });
    </script>
    </body>
</html>