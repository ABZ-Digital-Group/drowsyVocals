<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Staff Activity - Drowsy Vocals</title>
        <style>
            .staff-activity-page { max-width: 1320px; margin: 0 auto; padding: 38px 24px 64px; }
            .staff-activity-header { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 26px; }
            .staff-activity-heading { min-width: 0; }
            .staff-activity-header h1 { margin: 0 0 8px; color: var(--night-indigo); font-size: clamp(2em, 4vw, 3em); letter-spacing: -.03em; }
            .staff-activity-header p { margin: 0; color: var(--dusty-blue-purple); }
            .staff-activity-header .profile-eyebrow { margin-bottom: 8px; color: var(--dreamy-periwinkle); }
            .staff-activity-note { max-width: 420px; margin: 0; padding: 15px 17px; border: 1px solid var(--cloud-lilac); border-left: 4px solid var(--moonlight-yellow); border-radius: 12px; background: var(--cloud-white); box-shadow: 0 8px 22px rgba(41, 39, 82, .08); color: var(--night-indigo); font-size: .9em; line-height: 1.55; }
            .staff-activity-range { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
            .staff-activity-range a { padding: 9px 15px; border: 1px solid var(--cloud-lilac); border-radius: 999px; color: var(--night-indigo); background: var(--cloud-white); font-size: .9em; font-weight: bold; text-decoration: none; transition: background .2s ease, border-color .2s ease, color .2s ease; }
            .staff-activity-range a:hover { border-color: var(--dreamy-periwinkle); background: var(--cloud-lilac); }
            .staff-activity-range a[aria-current="page"] { border-color: var(--night-indigo); color: var(--cloud-white); background: var(--night-indigo); }
            .staff-activity-status { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 18px; color: var(--dusty-blue-purple); font-size: .85em; }
            .staff-activity-status-badge { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 999px; color: #1d6b46; background: #e1f4e9; font-weight: bold; }
            .staff-activity-status-badge.is-offline { color: #8b3d51; background: #f9e5eb; }
            .staff-activity-dot { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: #34a873; box-shadow: 0 0 0 4px rgba(52, 168, 115, .15); }
            .staff-activity-status-badge.is-offline .staff-activity-dot { background: #b94b68; box-shadow: 0 0 0 4px rgba(185, 75, 104, .12); }
            .staff-activity-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 14px; }
            .staff-activity-stat, .staff-activity-panel, .staff-activity-insight { border: 1px solid var(--cloud-lilac); border-radius: 14px; background: var(--cloud-white); box-shadow: 0 8px 24px rgba(41, 39, 82, .07); }
            .staff-activity-stat { position: relative; min-height: 106px; padding: 18px; overflow: hidden; }
            .staff-activity-stat::after { position: absolute; right: -24px; bottom: -34px; width: 110px; height: 110px; border-radius: 50%; background: rgba(146, 150, 232, .13); content: ''; }
            .staff-activity-stat span, .staff-activity-insight span { display: block; color: var(--dusty-blue-purple); font-size: .76em; font-weight: bold; letter-spacing: .06em; text-transform: uppercase; }
            .staff-activity-stat strong { position: relative; z-index: 1; display: block; margin-top: 8px; color: var(--night-indigo); font-size: 2em; letter-spacing: -.03em; }
            .staff-activity-insights { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 26px; }
            .staff-activity-insight { padding: 14px 16px; box-shadow: none; }
            .staff-activity-insight strong { display: block; margin-top: 5px; color: var(--night-indigo); font-size: 1.2em; }
            .staff-activity-insight small { display: block; margin-top: 3px; color: var(--dusty-blue-purple); }
            .staff-activity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
            .staff-activity-panel { min-width: 0; padding: 20px; }
            .staff-activity-panel-wide { grid-column: 1 / -1; }
            .staff-activity-panel h2 { margin: 0; color: var(--night-indigo); font-size: 1.15em; }
            .staff-activity-panel-heading { display: flex; align-items: start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
            .staff-activity-panel-heading p { margin: 4px 0 0; color: var(--dusty-blue-purple); font-size: .86em; }
            .staff-activity-panel-badge { flex: 0 0 auto; padding: 5px 9px; border-radius: 999px; color: var(--night-indigo); background: var(--cloud-lilac); font-size: .75em; font-weight: bold; }
            .staff-activity-list { display: grid; gap: 13px; margin: 0; padding: 0; list-style: none; }
            .staff-activity-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; }
            .staff-activity-label { min-width: 0; }
            .staff-activity-label strong, .staff-activity-label small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .staff-activity-label small { margin-top: 3px; color: var(--dusty-blue-purple); }
            .staff-activity-bar { height: 8px; margin-top: 7px; overflow: hidden; border-radius: 99px; background: var(--cloud-lilac); }
            .staff-activity-bar span { display: block; height: 100%; min-width: 3px; border-radius: inherit; background: linear-gradient(90deg, var(--dreamy-periwinkle), var(--deep-lilac)); }
            .staff-activity-hours { color: var(--night-indigo); font-weight: bold; white-space: nowrap; }
            .staff-activity-rank { display: inline-grid; width: 22px; height: 22px; place-items: center; margin-right: 6px; border-radius: 50%; color: var(--night-indigo); background: var(--cloud-lilac); font-size: .72em; vertical-align: 1px; }
            .staff-activity-live { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
            .staff-activity-live li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--cloud-lilac); }
            .staff-activity-live li:last-child { border-bottom: 0; }
            .staff-activity-live strong, .staff-activity-live span { display: block; }
            .staff-activity-live span { color: var(--dusty-blue-purple); font-size: .85em; text-align: right; }
            .staff-activity-live-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
            .staff-activity-empty { margin: 0; color: var(--dusty-blue-purple); }
            .staff-activity-chart { display: grid; grid-template-columns: repeat(14, minmax(18px, 1fr)); align-items: end; gap: clamp(4px, 1vw, 12px); min-height: 238px; padding: 18px 8px 0; border-top: 1px solid var(--cloud-lilac); background: repeating-linear-gradient(to bottom, transparent 0, transparent 47px, rgba(229, 225, 247, .7) 48px); }
            .staff-activity-chart-column { display: grid; grid-template-rows: 24px 170px 28px; align-items: end; min-width: 0; height: 222px; }
            .staff-activity-chart-value { overflow: hidden; color: var(--night-indigo); font-size: .68em; font-weight: bold; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
            .staff-activity-chart-track { display: flex; align-items: end; height: 170px; overflow: hidden; border-radius: 7px 7px 3px 3px; background: rgba(229, 225, 247, .5); }
            .staff-activity-chart-bar { width: 100%; min-height: 3px; border-radius: 7px 7px 3px 3px; background: linear-gradient(180deg, var(--dreamy-periwinkle), var(--deep-lilac)); }
            .staff-activity-chart-column small { overflow: hidden; color: var(--dusty-blue-purple); font-size: .7em; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
            .staff-activity-chart-caption { display: flex; justify-content: space-between; gap: 12px; margin-top: 10px; color: var(--dusty-blue-purple); font-size: .8em; }
            .staff-activity-table-wrap { overflow-x: auto; }
            .staff-activity-table { width: 100%; border-collapse: collapse; }
            .staff-activity-table th, .staff-activity-table td { padding: 12px 8px; border-bottom: 1px solid var(--cloud-lilac); text-align: left; vertical-align: top; }
            .staff-activity-table th { color: var(--dusty-blue-purple); font-size: .75em; letter-spacing: .05em; text-transform: uppercase; }
            .staff-activity-table td small { display: block; margin-top: 3px; color: var(--dusty-blue-purple); }
            @media (max-width: 800px) {
                .staff-activity-header { align-items: stretch; flex-direction: column; }
                .staff-activity-note { max-width: none; }
                .staff-activity-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                .staff-activity-insights { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                .staff-activity-grid { grid-template-columns: 1fr; }
                .staff-activity-panel-wide { grid-column: auto; }
            }
            @media (max-width: 480px) {
                .staff-activity-page { padding-right: 14px; padding-left: 14px; }
                .staff-activity-summary { grid-template-columns: 1fr; }
                .staff-activity-insights { grid-template-columns: 1fr; }
                .staff-activity-chart { gap: 3px; padding-right: 2px; padding-left: 2px; }
                .staff-activity-chart-column small { font-size: .62em; }
            }
        </style>
    </head>
    <body>
        <header><%- include('../partials/nav') %></header>
        <main class="staff-activity-page">
            <div class="staff-activity-header">
                <div class="staff-activity-heading">
                    <p class="profile-eyebrow">Management</p>
                    <h1>Staff Activity</h1>
                    <p>Voice activity recorded by DrowsyBot.</p>
                    <nav class="staff-activity-range" aria-label="Activity history range">
                        <a href="/staff-activity?range=7"<%= rangeDays === 7 ? ' aria-current="page"' : '' %>>Last 7 days</a>
                        <a href="/staff-activity?range=14"<%= rangeDays === 14 ? ' aria-current="page"' : '' %>>Last 14 days</a>
                    </nav>
                </div>
                <p class="staff-activity-note">Voice time excludes AFK channels, splits when someone changes channel, and ignores sessions shorter than one minute. Totals include live sessions after one minute and refresh automatically.</p>
            </div>

            <div class="staff-activity-status" aria-label="Monitoring status">
                <span class="staff-activity-status-badge<%= botOnline ? '' : ' is-offline' %>"><span class="staff-activity-dot" aria-hidden="true"></span><%= botOnline ? 'DrowsyBot online' : 'DrowsyBot offline' %></span>
                <% if (!trackingConfigured) { %>
                <span>Voice activity tracking is not configured.</span>
                <% } else if (botConnectionError) { %>
                <span><%= botConnectionError %></span>
                <% } else { %>
                <span>Live monitoring enabled · refreshes every minute</span>
                <% } %>
            </div>

            <section class="staff-activity-summary" aria-label="Activity summary">
                <div class="staff-activity-stat"><span>Voice hours (last <%= rangeDays %> days, incl. live)</span><strong><%= summary.hours.toFixed(2) %></strong></div>
                <div class="staff-activity-stat"><span>Completed sessions</span><strong><%= summary.sessions %></strong></div>
                <div class="staff-activity-stat"><span>Staff with activity</span><strong><%= summary.staffCount %></strong></div>
                <div class="staff-activity-stat"><span>Channels used</span><strong><%= summary.channelCount %></strong></div>
            </section>

            <section class="staff-activity-insights" aria-label="Activity insights">
                <div class="staff-activity-insight"><span>Active now</span><strong><%= live.length %> staff</strong><small><%= live.length ? 'Currently in tracked voice' : 'No one currently tracked' %></small></div>
                <div class="staff-activity-insight"><span>Active days</span><strong><%= summary.activeDays %> of <%= rangeDays %></strong><small>Days with recorded voice time</small></div>
                <div class="staff-activity-insight"><span>Daily average</span><strong><%= summary.averageDailyHours.toFixed(2) %>h</strong><small>Across the selected window</small></div>
                <div class="staff-activity-insight"><span>Busiest day</span><strong><%= summary.peakDay || 'No activity' %></strong><small><%= summary.peakHours.toFixed(2) %>h recorded</small></div>
            </section>

            <div class="staff-activity-grid">
                <section class="staff-activity-panel">
                    <div class="staff-activity-panel-heading">
                        <div><h2>Live in voice now</h2><p>Current staff presence</p></div>
                        <span class="staff-activity-panel-badge"><%= live.length %> online</span>
                    </div>
                    <% if (!live.length) { %>
                    <p class="staff-activity-empty"><%= botOnline ? 'No tracked staff are currently in voice.' : 'DrowsyBot is offline, so live presence is unavailable.' %></p>
                    <% } else { %>
                    <ul class="staff-activity-live">
                        <% live.forEach(function(member) { %>
                        <li>
                            <div class="staff-activity-live-name"><span class="staff-activity-dot" aria-hidden="true"></span><strong><%= member.displayName %></strong></div>
                            <span><%= member.channelName %> · <%= member.durationMinutes %> min<% if (member.joinedAt) { %><br>since <%= member.joinedAt %><% } %></span>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>
                </section>

                <section class="staff-activity-panel">
                    <div class="staff-activity-panel-heading">
                        <div><h2>Top staff by hours</h2><p>Highest voice time in this window</p></div>
                        <span class="staff-activity-panel-badge">Top 10</span>
                    </div>
                    <% if (!staff.length) { %>
                    <p class="staff-activity-empty">No completed voice sessions have been recorded yet.</p>
                    <% } else { const maxStaffHours = Math.max(...staff.map(function(item) { return item.hours; }), 1); %>
                    <ul class="staff-activity-list">
                        <% staff.slice(0, 10).forEach(function(item, index) { %>
                        <li>
                            <div class="staff-activity-label"><strong><span class="staff-activity-rank"><%= index + 1 %></span><%= item.displayName %></strong><small><%= item.sessions %> session<%= item.sessions === 1 ? '' : 's' %></small><div class="staff-activity-bar"><span style="width: <%= Math.max(2, item.hours / maxStaffHours * 100) %>%"></span></div></div>
                            <span class="staff-activity-hours"><%= item.hours.toFixed(2) %>h</span>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>
                </section>

                <section class="staff-activity-panel">
                    <div class="staff-activity-panel-heading">
                        <div><h2>Most-used channels</h2><p>Where staff spend their time</p></div>
                        <span class="staff-activity-panel-badge">Top 10</span>
                    </div>
                    <% if (!channels.length) { %>
                    <p class="staff-activity-empty">No channel activity has been recorded yet.</p>
                    <% } else { const maxChannelHours = Math.max(...channels.map(function(item) { return item.hours; }), 1); %>
                    <ul class="staff-activity-list">
                        <% channels.slice(0, 10).forEach(function(item, index) { %>
                        <li>
                            <div class="staff-activity-label"><strong><span class="staff-activity-rank"><%= index + 1 %></span>#<%= item.channelName %></strong><small><%= item.guildName %> · <%= item.sessions %> session<%= item.sessions === 1 ? '' : 's' %></small><div class="staff-activity-bar"><span style="width: <%= Math.max(2, item.hours / maxChannelHours * 100) %>%"></span></div></div>
                            <span class="staff-activity-hours"><%= item.hours.toFixed(2) %>h</span>
                        </li>
                        <% }); %>
                    </ul>
                    <% } %>
                </section>

                <section class="staff-activity-panel staff-activity-panel-wide">
                    <div class="staff-activity-panel-heading">
                        <div><h2>Daily voice trend</h2><p>Hours recorded for each day in the selected <%= rangeDays %>-day window</p></div>
                        <span class="staff-activity-panel-badge">Hours</span>
                    </div>
                    <% if (!daily.length) { %>
                    <p class="staff-activity-empty">No daily activity has been recorded yet.</p>
                    <% } else { const maxDailyHours = Math.max(...daily.map(function(item) { return item.hours; }), 1); %>
                    <div class="staff-activity-chart" style="grid-template-columns: repeat(<%= daily.length %>, minmax(18px, 1fr));" role="img" aria-label="Daily voice hours chart">
                        <% daily.forEach(function(item) { %>
                        <div class="staff-activity-chart-column" title="<%= item.date %>: <%= item.hours.toFixed(2) %> hours, <%= item.sessions %> sessions">
                            <span class="staff-activity-chart-value"><%= item.hours ? item.hours.toFixed(1) + 'h' : '—' %></span>
                            <div class="staff-activity-chart-track"><span class="staff-activity-chart-bar" style="height: <%= item.hours ? Math.max(4, item.hours / maxDailyHours * 100) : 0 %>%"></span></div>
                            <small><%= item.date.slice(5) %></small>
                        </div>
                        <% }); %>
                    </div>
                    <div class="staff-activity-chart-caption"><span>Each bar shows voice time for that day</span><span><%= daily.reduce(function(total, item) { return total + item.sessions; }, 0) %> daily session entries</span></div>
                    <% } %>
                </section>

                <section class="staff-activity-panel staff-activity-panel-wide">
                    <div class="staff-activity-panel-heading">
                        <div><h2>Recent completed activity</h2><p>Latest sessions from the last <%= rangeDays %> days</p></div>
                        <span class="staff-activity-panel-badge">Newest first</span>
                    </div>
                    <% if (!recent.length) { %>
                    <p class="staff-activity-empty">No completed voice sessions have been recorded yet.</p>
                    <% } else { %>
                    <div class="staff-activity-table-wrap">
                        <table class="staff-activity-table">
                            <thead><tr><th>Staff member</th><th>Channel</th><th>Started</th><th>Ended</th><th>Duration</th></tr></thead>
                            <tbody>
                                <% recent.forEach(function(session) { %>
                                <tr>
                                    <td><strong><%= session.displayName %></strong><small><%= session.guildName %></small></td>
                                    <td>#<%= session.channelName %></td>
                                    <td><%= session.startedAt %></td>
                                    <td><%= session.endedAt %></td>
                                    <td><%= session.durationMinutes %> min</td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </section>
            </div>
        </main>
        <div class="footer"><p>&copy; 2026 Drowsy Vocals | All rights reserved.</p></div>
        <script>
            window.setTimeout(() => window.location.reload(), 60 * 1000);
        </script>
    </body>
</html>
