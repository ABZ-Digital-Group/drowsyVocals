<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Vocals</title>
    </head>
    <body class="<%= seasonalTheme === 'halloween' ? 'halloween-login-page' : (seasonalTheme === 'christmas' ? 'christmas-login-page' : '') %>">
        <main class="login-page">
            <section class="login-container">
                <div class="Logo">
                    <img src="/assets/drowsyNew.png" alt="Drowsy Vocals Logo">
                </div>
                <div class="login-form">
                    <% const loginSuccessMessage = Array.isArray(success_msg) ? success_msg[0] : success_msg; %>
                    <% const loginErrorMessage = Array.isArray(error_msg) ? error_msg[0] : error_msg; %>
                    <% if (loginSuccessMessage) { %>
                    <div class="login-form-message is-success" role="status"><%= loginSuccessMessage %></div>
                    <% } %>
                    <% if (loginErrorMessage) { %>
                    <div class="login-form-message is-error" role="alert"><%= loginErrorMessage %></div>
                    <% } %>
                    <form class="login-form-actions" action="/login" method="POST">

                        <label for="discordId">Discord ID:</label>
                        <input type="text" id="discordId" name="discordId" required>

                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password" required>

                        <button type="submit">Login</button>
                    </form>
                    <div class="login-helper-links">
                        <a href="/forgot-password" class="login-help-link">Forgot your password?</a>
                    </div>
                    <div class="footer">
                        <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
                    </div>
                </div>
            </section>
        </main>
        <script>
            window.history.replaceState({}, '', '/index');
        </script>
    </body>
</html>
