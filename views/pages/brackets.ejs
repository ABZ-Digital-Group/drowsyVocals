<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Event Brackets - Drowsy Vocals</title>
    </head>
    <body>
        <header><%- include('../partials/nav') %></header>
        <main>
            <section class="settings-page brackets-page">
                <div class="settings-header">
                    <div class="settings-header-top">
                        <div>
                            <p class="profile-eyebrow">Competition tools</p>
                            <h1 style="margin: 0; font-size: 2.4em; color: var(--night-indigo);">Event Brackets</h1>
                            <p class="profile-subtitle">Build a bracket that fits each event, then update results as the competition runs.</p>
                        </div>
                        <span class="bracket-header-icon material-symbols-outlined" aria-hidden="true">account_tree</span>
                    </div>
                </div>

                <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
                <div class="settings-alert is-success"><span><%= success_msg %></span></div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
                <div class="settings-alert is-error"><span><%= error_msg %></span></div>
                <% } %>

                <div class="brackets-layout">
                    <aside class="account-card bracket-sidebar">
                        <div class="account-card-header">
                            <h2 class="account-card-title"><span class="material-symbols-outlined">trophy</span><span>Event brackets</span></h2>
                            <span class="account-badge"><%= brackets.length %></span>
                        </div>
                        <% if (!brackets.length) { %>
                        <p class="bracket-empty">No brackets have been created yet.</p>
                        <% } else { %>
                        <div class="bracket-list">
                            <% brackets.forEach(function(bracket) { %>
                            <a class="bracket-list-item <%= selectedBracket && String(selectedBracket._id) === String(bracket._id) ? 'is-selected' : '' %>" href="/brackets?id=<%= bracket._id %>">
                                <strong><%= bracket.title %></strong>
                                <span><%= bracket.eventTitle %></span>
                                <small><%= bracket.format === 'double' ? 'Double elimination' : 'Single elimination' %> · <%= (bracket.participants || []).length %> players</small>
                            </a>
                            <% }); %>
                        </div>
                        <% } %>
                        <% if (isManager) { %>
                        <form class="bracket-create-form" action="/brackets/create" method="POST">
                            <h3>Create a bracket</h3>
                            <label for="bracketTitle">Bracket name</label>
                            <input id="bracketTitle" name="title" class="settings-input" placeholder="Friday Night Finals" required>
                            <label for="bracketEvent">Event</label>
                            <select id="bracketEvent" name="eventId" class="settings-input">
                                <option value="">Assign an event later</option>
                                <% events.forEach(function(event) { %>
                                <option value="<%= event.id || event._id %>"><%= event.title %></option>
                                <% }); %>
                            </select>
                            <label for="bracketFormat">Format</label>
                            <select id="bracketFormat" name="format" class="settings-input">
                                <option value="single">Single elimination</option>
                                <option value="double">Double elimination</option>
                                <option value="round_robin">Round robin</option>
                                <option value="groups">Groups / pools</option>
                            </select>
                            <label for="bracketBestOf">Match format</label>
                            <select id="bracketBestOf" name="bestOf" class="settings-input">
                                <option value="bo1">Best of 1</option>
                                <option value="bo3">Best of 3</option>
                                <option value="bo5">Best of 5</option>
                                <option value="custom">Custom</option>
                            </select>
                            <label for="bracketCapacity">Maximum participants</label>
                            <select id="bracketCapacity" name="maxParticipants" class="settings-input">
                                <% [2, 4, 8, 16, 32, 64].forEach(function(size) { %>
                                <option value="<%= size %>" <%= size === 16 ? 'selected' : '' %>><%= size %> participants</option>
                                <% }); %>
                            </select>
                            <button class="settings-btn settings-btn-primary" type="submit"><span class="material-symbols-outlined">add</span>Create bracket</button>
                        </form>
                        <% } %>
                    </aside>

                    <section class="account-card bracket-editor">
                    <% if (!selectedBracket) { %>
                        <div class="bracket-empty bracket-empty-large">
                            <span class="material-symbols-outlined">account_tree</span>
                            <h2>Select or create a bracket</h2>
                            <p>Brackets are saved independently for each event, so every event can have its own format and participants.</p>
                        </div>
                    <% } else { %>
                        <div class="account-card-header bracket-editor-header">
                            <div>
                                <h2 class="account-card-title"><span class="material-symbols-outlined">emoji_events</span><span><%= selectedBracket.title %></span></h2>
                                <p class="bracket-event-label"><%= selectedBracket.eventTitle %></p>
                            </div>
                            <div class="bracket-header-actions">
                                <button type="button" class="settings-btn settings-btn-secondary settings-btn-sm" id="toggleBracketFullscreen">
                                    <span class="material-symbols-outlined">fullscreen</span><span class="fullscreen-button-label">Stream fullscreen</span>
                                </button>
                                <% if (isManager) { %>
                                <form action="/brackets/<%= selectedBracket._id %>/delete" method="POST" onsubmit="return confirm('Delete this bracket?')">
                                    <button class="settings-btn settings-btn-danger settings-btn-sm" type="submit">Delete</button>
                                </form>
                                <% } %>
                            </div>
                        </div>
                        <% if (isManager) { %>
                        <div class="bracket-controls">
                            <div>
                                <label for="bracketEventAssignment">Assigned event</label>
                                <select id="bracketEventAssignment" class="settings-input">
                                    <option value="">Unassigned - link this bracket later</option>
                                    <% events.forEach(function(event) { %>
                                    <option value="<%= event.id || event._id %>" <%= String(selectedBracket.eventId || '') === String(event.id || event._id) ? 'selected' : '' %>><%= event.title %></option>
                                    <% }); %>
                                </select>
                                <label for="bracketCapacityAssignment">Maximum participants</label>
                                <select id="bracketCapacityAssignment" class="settings-input">
                                    <% [2, 4, 8, 16, 32, 64].forEach(function(size) { %>
                                    <option value="<%= size %>" <%= Number(selectedBracket.maxParticipants || 16) === size ? 'selected' : '' %>><%= size %> participants</option>
                                    <% }); %>
                                </select>
                                <label for="bracketFormatAssignment">Bracket format</label>
                                <select id="bracketFormatAssignment" class="settings-input">
                                    <% [['single', 'Single elimination'], ['double', 'Double elimination'], ['round_robin', 'Round robin'], ['groups', 'Groups / pools']].forEach(function(option) { %>
                                    <option value="<%= option[0] %>" <%= (selectedBracket.format || 'single') === option[0] ? 'selected' : '' %>><%= option[1] %></option>
                                    <% }); %>
                                </select>
                                <label for="bracketBestOfAssignment">Match format</label>
                                <select id="bracketBestOfAssignment" class="settings-input">
                                    <% [['bo1', 'Best of 1'], ['bo3', 'Best of 3'], ['bo5', 'Best of 5'], ['custom', 'Custom']].forEach(function(option) { %>
                                    <option value="<%= option[0] %>" <%= (selectedBracket.bestOf || 'bo1') === option[0] ? 'selected' : '' %>><%= option[1] %></option>
                                    <% }); %>
                                </select>
                                <label for="bracketNotes">Event notes</label>
                                <textarea id="bracketNotes" class="settings-input" rows="2" placeholder="Rules, judging notes, or stream details..."></textarea>
                            </div>
                            <div class="bracket-control-actions">
                                <button type="button" class="settings-btn settings-btn-secondary" id="seedBracket"><span class="material-symbols-outlined">shuffle</span>Seed bracket</button>
                                <button type="button" class="settings-btn settings-btn-primary" id="saveBracket"><span class="material-symbols-outlined">save</span>Save changes</button>
                            </div>
                            <p class="bracket-save-status" id="bracketSaveStatus" role="status"></p>
                        </div>
                        <% } %>
                        <div class="bracket-workspace">
                            <div class="bracket-stream-loading" id="bracketStreamLoading" hidden role="status" aria-live="polite">
                                <div class="bracket-stream-loading-content">
                                    <img src="/assets/drowsyNew.png" alt="Drowsy Vocals">
                                    <span class="material-symbols-outlined" aria-hidden="true">sync</span>
                                    <strong>Updating bracket</strong>
                                    <span>Results are being refreshed for the stream...</span>
                                </div>
                            </div>
                            <div class="bracket-participants">
                                            <div class="bracket-section-heading"><h3>Participants</h3><span id="participantCount"></span></div>
                                <div id="participantList"></div>
                                <% if (isManager) { %><button type="button" class="settings-btn settings-btn-secondary settings-btn-sm" id="addParticipant"><span class="material-symbols-outlined">person_add</span>Add participant</button><% } %>
                            </div>
                            <div class="bracket-board-wrap">
                                <div class="bracket-section-heading"><h3><%= ({ single: 'Single elimination', double: 'Double elimination', round_robin: 'Round robin', groups: 'Groups / pools' })[selectedBracket.format || 'single'] %></h3><span id="roundCount"></span></div>
                                <div class="bracket-stream-pagination" id="bracketStreamPagination" hidden>
                                    <button type="button" class="settings-btn settings-btn-secondary settings-btn-sm" id="bracketStreamPrevious">Previous</button>
                                    <span id="bracketStreamPageLabel"></span>
                                    <button type="button" class="settings-btn settings-btn-secondary settings-btn-sm" id="bracketStreamNext">Next</button>
                                </div>
                                <div class="bracket-board" id="bracketBoard"></div>
                            </div>
                        </div>
                    <% } %>
                    </section>
                </div>
            </section>
        </main>
        <%- include('../partials/footer') %>
        <% if (selectedBracket) { %>
        <script>
            (() => {
                const canEdit = <%= isManager ? 'true' : 'false' %>;
                const bracketId = <%- JSON.stringify(String(selectedBracket._id)) %>;
                const initial = <%- JSON.stringify({
                    participants: selectedBracket.participants || [],
                    rounds: selectedBracket.rounds || [],
                    notes: selectedBracket.notes || '',
                    format: selectedBracket.format || 'single'
                }).replace(/</g, '\\u003c') %>;
                let state = {
                    participants: Array.isArray(initial.participants) ? initial.participants.map((name) => String(name).slice(0, 80)) : [],
                    rounds: Array.isArray(initial.rounds) ? initial.rounds : [],
                    notes: String(initial.notes || '').slice(0, 1000),
                    maxParticipants: [2, 4, 8, 16, 32, 64].includes(Number(<%= Number(selectedBracket.maxParticipants || 16) %>)) ? Number(<%= Number(selectedBracket.maxParticipants || 16) %>) : 16,
                    format: <%- JSON.stringify(selectedBracket.format || 'single') %>,
                    bestOf: <%- JSON.stringify(selectedBracket.bestOf || 'bo1') %>
                };
                let lastUpdateAt = <%- JSON.stringify(selectedBracket.updatedAt || '') %>;
                let localChangePending = false;
                let loadingTransitionId = 0;
                let streamRoundPage = 0;
                let streamMatchPage = 0;
                const streamMatchesPerPage = 4;
                function stateFingerprint(value) {
                    return JSON.stringify({
                        participants: value.participants || [],
                        rounds: value.rounds || [],
                        notes: value.notes || '',
                        format: value.format || 'single',
                        bestOf: value.bestOf || 'bo1',
                        maxParticipants: value.maxParticipants || 16
                    });
                }
                const list = document.getElementById('participantList');
                const board = document.getElementById('bracketBoard');
                const notes = document.getElementById('bracketNotes');
                if (notes) notes.value = state.notes;

                function makeMatch(a, b) {
                    return { players: [a || 'BYE', b || 'BYE'], scores: ['', ''], winner: a && !b ? 0 : b && !a ? 1 : null };
                }
                function generateRounds() {
                    const names = state.participants.filter(Boolean);
                    if (!names.length) { state.rounds = []; return; }
                    const size = Math.pow(2, Math.ceil(Math.log2(Math.max(2, names.length))));
                    const seeded = names.concat(Array(size - names.length).fill('BYE'));
                    const rounds = [[...Array(size / 2)].map((_, i) => makeMatch(seeded[i * 2], seeded[i * 2 + 1]))];
                    while (rounds[rounds.length - 1].length > 1) {
                        rounds.push([...Array(Math.ceil(rounds[rounds.length - 1].length / 2))].map(() => makeMatch('', '')));
                    }
                    state.rounds = rounds;
                }
                function setWinner(roundIndex, matchIndex, slot) {
                    const match = state.rounds[roundIndex][matchIndex];
                    match.winner = match.winner === slot ? null : slot;
                    if (roundIndex < state.rounds.length - 1) {
                        const nextMatch = state.rounds[roundIndex + 1][Math.floor(matchIndex / 2)];
                        const nextSlot = matchIndex % 2;
                        nextMatch.players[nextSlot] = match.winner === null ? '' : (match.players[match.winner] || 'TBD');
                        nextMatch.winner = null;
                    }
                }
                function renderParticipants() {
                    list.innerHTML = '';
                    state.participants.forEach((name, index) => {
                        const row = document.createElement('div');
                        row.className = 'bracket-participant-row';
                        row.innerHTML = `<span>${index + 1}</span><input class="settings-input" maxlength="80" value="${escapeHtml(name)}" aria-label="Participant ${index + 1}" ${canEdit ? '' : 'disabled'}>${canEdit ? '<button type="button" class="bracket-remove" aria-label="Remove participant">&times;</button>' : ''}`;
                        row.querySelector('input').addEventListener('input', (event) => {
                            localChangePending = true;
                            state.participants[index] = event.target.value;
                            const openingMatch = state.rounds[0]?.[Math.floor(index / 2)];
                            if (openingMatch) openingMatch.players[index % 2] = event.target.value || 'BYE';
                            renderBoard();
                        });
                        if (canEdit) {
                            row.querySelector('input').addEventListener('change', () => persistState('Saving participant...'));
                            row.querySelector('button').addEventListener('click', () => {
                                state.participants.splice(index, 1);
                                generateRounds();
                                render();
                                persistState('Removing participant...');
                            });
                        }
                        list.appendChild(row);
                    });
                    document.getElementById('participantCount').textContent = `${state.participants.length}/${state.maxParticipants} players`;
                    const addButton = document.getElementById('addParticipant');
                    if (addButton) addButton.disabled = state.participants.length >= state.maxParticipants;
                }
                function renderBoard() {
                    board.innerHTML = '';
                    const presentation = document.fullscreenElement === bracketEditor || bracketEditor.classList.contains('is-streaming');
                    board.style.setProperty('--round-count', Math.max(1, state.rounds.length));
                    state.rounds.forEach((round, roundIndex) => {
                        const column = document.createElement('div');
                        column.className = 'bracket-round';
                        column.innerHTML = `<h4>${roundIndex === state.rounds.length - 1 ? 'Final' : `Round ${roundIndex + 1}`}</h4>`;
                        const matches = round.map((match, matchIndex) => ({ match, matchIndex }));
                        matches.forEach(({ match, matchIndex }) => {
                            const card = document.createElement('div');
                            card.className = 'bracket-match';
                            card.innerHTML = match.players.map((player, slot) => `<div class="bracket-player ${match.winner === slot ? 'is-winner' : ''}"><span>${escapeHtml(player || 'TBD')}</span><input type="number" min="0" max="999" aria-label="Score" value="${escapeHtml(String(match.scores?.[slot] || ''))}" ${!canEdit ? 'disabled' : ''}></div>`).join('');
                            if (canEdit) {
                                card.querySelectorAll('.bracket-player').forEach((player, slot) => player.addEventListener('click', (event) => {
                                    if (event.target.tagName === 'INPUT') return;
                                    setWinner(roundIndex, matchIndex, slot);
                                    renderBoard();
                                    persistState('Saving result...');
                                }));
                                card.querySelectorAll('input').forEach((input, slot) => {
                                    input.addEventListener('input', (event) => {
                                        localChangePending = true;
                                        match.scores[slot] = event.target.value;
                                    });
                                    input.addEventListener('change', () => persistState('Saving score...'));
                                });
                            }
                            column.appendChild(card);
                        });
                        board.appendChild(column);
                    });
                    const pagination = document.getElementById('bracketStreamPagination');
                    const pageLabel = document.getElementById('bracketStreamPageLabel');
                    if (pagination) pagination.hidden = true;
                    if (pageLabel) pageLabel.textContent = '';
                    document.getElementById('roundCount').textContent = state.rounds.length ? `${state.rounds.length} round${state.rounds.length === 1 ? '' : 's'}` : 'Add participants to begin';
                    window.requestAnimationFrame(() => window.requestAnimationFrame(fitStreamBoard));
                }
                function fitStreamBoard() {
                    const presentation = document.fullscreenElement === bracketEditor || bracketEditor.classList.contains('is-streaming');
                    if (!presentation) {
                        board.style.transform = '';
                        board.style.transformOrigin = '';
                        return;
                    }
                    const wrapper = board.parentElement;
                    const rounds = Array.from(board.querySelectorAll('.bracket-round'));
                    if (!wrapper || !rounds.length) return;
                    board.style.transform = 'none';
                    const contentHeight = Math.max(...rounds.map((round) => {
                        const roundTop = round.getBoundingClientRect().top;
                        const matchBottoms = Array.from(round.querySelectorAll('.bracket-match'))
                            .map((match) => match.getBoundingClientRect().bottom);
                        return matchBottoms.length ? Math.max(...matchBottoms) - roundTop : round.scrollHeight;
                    }));
                    const availableHeight = Math.max(1, wrapper.clientHeight - 12);
                    const scale = Math.min(1, availableHeight / contentHeight);
                    board.style.transform = `scale(${scale})`;
                    board.style.transformOrigin = 'top left';
                }
                function render() { renderParticipants(); renderBoard(); }
                function escapeHtml(value) { return value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character])); }
                function applyRemoteState(remoteState) {
                    const loading = document.getElementById('bracketStreamLoading');
                    const isPresentation = document.fullscreenElement === bracketEditor || bracketEditor.classList.contains('is-streaming');
                    const loadingStartedAt = Date.now();
                    const transitionId = ++loadingTransitionId;
                    if (loading && isPresentation) {
                        loading.hidden = false;
                        loading.classList.remove('is-exiting');
                        loading.classList.remove('is-entering');
                        void loading.offsetWidth;
                        loading.classList.add('is-entering');
                    }
                    state.participants = Array.isArray(remoteState.participants) ? remoteState.participants.map((name) => String(name).slice(0, 80)) : [];
                    state.rounds = Array.isArray(remoteState.rounds) ? remoteState.rounds : [];
                    state.notes = String(remoteState.notes || '').slice(0, 1000);
                    state.maxParticipants = Number(remoteState.maxParticipants) || state.maxParticipants;
                    state.format = remoteState.format || state.format;
                    state.bestOf = remoteState.bestOf || state.bestOf;
                    if (notes) notes.value = state.notes;
                    const capacity = document.getElementById('bracketCapacityAssignment');
                    const format = document.getElementById('bracketFormatAssignment');
                    const bestOf = document.getElementById('bracketBestOfAssignment');
                    if (capacity) capacity.value = String(state.maxParticipants);
                    if (format) format.value = state.format;
                    if (bestOf) bestOf.value = state.bestOf;
                    render();
                    if (loading && isPresentation) {
                        const minimumDisplayTime = 650;
                        window.setTimeout(() => {
                            if (transitionId !== loadingTransitionId) return;
                            loading.classList.remove('is-entering');
                            loading.classList.add('is-exiting');
                            window.setTimeout(() => {
                                if (transitionId !== loadingTransitionId) return;
                                loading.hidden = true;
                                loading.classList.remove('is-exiting');
                            }, 400);
                        }, Math.max(0, minimumDisplayTime - (Date.now() - loadingStartedAt)));
                    } else if (loading) {
                        loading.hidden = true;
                    }
                }
                async function persistState(statusText = 'Saving...') {
                    const status = document.getElementById('bracketSaveStatus');
                    if (status) status.textContent = statusText;
                    localChangePending = true;
                    state.notes = notes.value.slice(0, 1000);
                    state.eventId = document.getElementById('bracketEventAssignment')?.value || '';
                    state.maxParticipants = Number(document.getElementById('bracketCapacityAssignment')?.value || state.maxParticipants);
                    state.format = document.getElementById('bracketFormatAssignment')?.value || state.format;
                    state.bestOf = document.getElementById('bracketBestOfAssignment')?.value || state.bestOf;
                    try {
                        const response = await fetch(`/brackets/${bracketId}/save`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state) });
                        if (!response.ok) throw new Error('Save failed');
                        const saved = await response.json();
                        lastUpdateAt = saved.updatedAt || lastUpdateAt;
                        localChangePending = false;
                        if (status) status.textContent = 'Saved just now';
                    } catch (error) {
                        if (status) status.textContent = 'Could not save participant changes.';
                    }
                }
                document.getElementById('addParticipant')?.addEventListener('click', () => {
                    if (state.participants.length >= state.maxParticipants) return;
                    state.participants.push('');
                    generateRounds();
                    render();
                    list.lastElementChild?.querySelector('input')?.focus();
                });
                document.getElementById('bracketCapacityAssignment')?.addEventListener('change', (event) => {
                    state.maxParticipants = Number(event.target.value);
                    state.participants = state.participants.slice(0, state.maxParticipants);
                    generateRounds();
                    render();
                });
                document.getElementById('bracketFormatAssignment')?.addEventListener('change', (event) => {
                    state.format = event.target.value;
                    generateRounds();
                    render();
                });
                document.getElementById('bracketBestOfAssignment')?.addEventListener('change', (event) => { state.bestOf = event.target.value; });
                document.getElementById('seedBracket')?.addEventListener('click', () => { state.participants.sort(() => Math.random() - 0.5); generateRounds(); render(); });
                const bracketEditor = document.querySelector('.bracket-editor');
                const fullscreenButton = document.getElementById('toggleBracketFullscreen');
                function updateFullscreenButton() {
                    const active = document.fullscreenElement === bracketEditor || bracketEditor.classList.contains('is-streaming');
                    document.documentElement.style.overflow = active ? 'hidden' : '';
                    document.body.style.overflow = active ? 'hidden' : '';
                    fullscreenButton.querySelector('.material-symbols-outlined').textContent = active ? 'fullscreen_exit' : 'fullscreen';
                    fullscreenButton.querySelector('.fullscreen-button-label').textContent = active ? 'Exit fullscreen' : 'Stream fullscreen';
                }
                fullscreenButton.addEventListener('click', async () => {
                    try {
                        if (document.fullscreenElement === bracketEditor) {
                            await document.exitFullscreen();
                        } else if (document.fullscreenEnabled && bracketEditor.requestFullscreen) {
                            await bracketEditor.requestFullscreen();
                        } else {
                            bracketEditor.classList.toggle('is-streaming');
                        }
                    } catch (error) {
                        bracketEditor.classList.toggle('is-streaming');
                    }
                    updateFullscreenButton();
                    renderBoard();
                });
                document.addEventListener('fullscreenchange', updateFullscreenButton);
                document.addEventListener('fullscreenchange', () => {
                    streamRoundPage = 0;
                    streamMatchPage = 0;
                    renderBoard();
                    window.requestAnimationFrame(fitStreamBoard);
                });
                window.addEventListener('resize', fitStreamBoard);
                document.getElementById('bracketStreamPrevious')?.addEventListener('click', () => {
                    if (streamMatchPage > 0) streamMatchPage -= 1;
                    else if (streamRoundPage > 0) {
                        streamRoundPage -= 1;
                        streamMatchPage = Math.max(0, Math.ceil((state.rounds[streamRoundPage]?.length || 1) / streamMatchesPerPage) - 1);
                    }
                    renderBoard();
                });
                document.getElementById('bracketStreamNext')?.addEventListener('click', () => {
                    const currentRound = state.rounds[streamRoundPage] || [];
                    const lastMatchPage = Math.max(0, Math.ceil(currentRound.length / streamMatchesPerPage) - 1);
                    if (streamMatchPage < lastMatchPage) streamMatchPage += 1;
                    else if (streamRoundPage < state.rounds.length - 1) {
                        streamRoundPage += 1;
                        streamMatchPage = 0;
                    }
                    renderBoard();
                });
                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape' && bracketEditor.classList.contains('is-streaming')) {
                        bracketEditor.classList.remove('is-streaming');
                        updateFullscreenButton();
                    }
                });
                document.getElementById('saveBracket')?.addEventListener('click', async () => {
                    await persistState();
                });
                if (!state.rounds.length) generateRounds();
                render();
                if (window.io) {
                    const bracketSocket = window.io();
                    bracketSocket.on('bracket-updated', (payload) => {
                        if (String(payload?.bracketId) !== bracketId || !payload?.state) return;
                        if (localChangePending) return;
                        lastUpdateAt = payload.updatedAt || lastUpdateAt;
                        applyRemoteState(payload.state);
                    });
                }
                setInterval(async () => {
                    try {
                        const response = await fetch(`/brackets/${bracketId}/state`, { cache: 'no-store' });
                        if (!response.ok) {
                            console.warn('Bracket state request returned:', response.status);
                            return;
                        }
                        const payload = await response.json();
                        if (!localChangePending && payload.state && (payload.updatedAt !== lastUpdateAt || stateFingerprint(payload.state) !== stateFingerprint(state))) {
                            lastUpdateAt = payload.updatedAt || lastUpdateAt;
                            applyRemoteState(payload.state);
                        }
                    } catch (error) {
                        console.warn('Bracket state polling failed:', error.message);
                    }
                }, 2500);
            })();
        </script>
        <% } %>
    </body>
</html>
