<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Settings</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="profile-page">
                <div class="profile-heading">
                    <p class="profile-eyebrow">Management</p>
                    <h1>Settings</h1>
                    <p class="profile-subtitle">Manage the rank, house, shift, and activity options used across the roster forms.</p>
                </div>
                <div class="profile-details">
                    <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper) { %>
                    <div class="profile-detail-full">
                        <span>Maintenance Mode</span>
                        <p class="settings-hint">When active, only Realm Gods, Mr. Sandman, and Developers can access the site. All other users and visitors will see the maintenance screen.</p>
                        <form class="login-form-actions settings-add-form" action="/settings/maintenance" method="POST">
                            <div class="maintenance-toggle-row">
                                <input type="checkbox" id="maintenanceEnabled" name="enabled" value="true" <%= settings.maintenance?.enabled ? 'checked' : '' %>>
                                <label for="maintenanceEnabled">Enable Maintenance Mode</label>
                            </div>
                            <label for="maintenanceMessage">Public Notice Message:</label>
                            <textarea id="maintenanceMessage" name="message" rows="3" style="width: 100%; border-radius: 4px; padding: 8px; background: #1a1917; color: #B7B2A7; border: 1px solid #444;"><%= settings.maintenance?.message || 'The website is currently undergoing scheduled maintenance. Please check back soon.' %></textarea>
                            <button type="submit" style="margin-top: 10px;">Save Maintenance Settings</button>
                        </form>
                    </div>

                    <div class="profile-detail-full">
                        <span>Discord Webhooks & Google Forms</span>
                        <p class="settings-hint">Post real-time embeds to a Discord channel when events occur, and connect your Google Forms staff application.</p>
                        <form class="login-form-actions settings-add-form" action="/settings/webhooks" method="POST">
                            <label for="webhookUrl">Discord Webhook URL:</label>
                            <input type="url" id="webhookUrl" name="url" placeholder="https://discord.com/api/webhooks/..." value="<%= settings.webhooks?.url || '' %>">

                            <label for="applicationsSecret" style="margin-top:10px;">Google Form Webhook Secret Key:</label>
                            <input type="text" id="applicationsSecret" name="applicationsSecret" value="<%= settings.webhooks?.applicationsSecret || 'drowsy-apps-secret' %>" required>

                            <div class="maintenance-toggle-row" style="flex-wrap: wrap; gap: 16px; margin: 12px 0;">
                                <label style="display: flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" name="notifyLoa" value="true" <%= settings.webhooks?.notifyLoa !== false ? 'checked' : '' %>>
                                    <span>LOA Requests & Decisions</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" name="notifyStrikes" value="true" <%= settings.webhooks?.notifyStrikes !== false ? 'checked' : '' %>>
                                    <span>Issued Strikes</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" name="notifyFeedback" value="true" <%= settings.webhooks?.notifyFeedback !== false ? 'checked' : '' %>>
                                    <span>Submitted Feedback</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-weight: normal; cursor: pointer;">
                                    <input type="checkbox" name="notifyApplications" value="true" <%= settings.webhooks?.notifyApplications !== false ? 'checked' : '' %>>
                                    <span>New Staff Applications</span>
                                </label>
                            </div>
                            <button type="submit">Save Webhook Settings</button>
                        </form>

                        <details style="margin-top:15px;background:#1a1917;padding:12px;border-radius:6px;border:1px solid #333;">
                            <summary style="cursor:pointer;font-weight:bold;color:#B7B2A7;">Google Form Setup Instructions (Click to expand)</summary>
                            <div style="margin-top:10px;font-size:0.9em;line-height:1.6;color:#ccc;">
                                <p>1. Open your Google Form &gt; Click the <strong>three dots (⋮)</strong> &gt; <strong>Script editor</strong>.</p>
                                <p>2. Paste the following script:</p>
                                <pre style="background:#000;padding:10px;border-radius:4px;overflow-x:auto;color:#3ddc71;font-size:0.85em;">function onFormSubmit(e) {
  var itemResponses = e.response.getItemResponses();
  var answers = {};
  for (var i = 0; i &lt; itemResponses.length; i++) {
    answers[itemResponses[i].getItem().getTitle()] = itemResponses[i].getResponse();
  }

  var payload = {
    secret: "<%= settings.webhooks?.applicationsSecret || 'drowsy-apps-secret' %>",
    answers: answers
  };

  UrlFetchApp.fetch("https://manage.drowsyvocals.com/api/applications/webhook", {
    method: "post",
    contentType: "application/json",
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });
}</pre>
                                <p>3. In the Apps Script sidebar, click the <strong>Triggers (alarm clock icon)</strong> &gt; <strong>Add Trigger</strong>.</p>
                                <p>4. Set <em>Choose which function to run</em> to <code>onFormSubmit</code> and <em>Select event type</em> to <strong>On form submit</strong> &gt; Click <strong>Save</strong>.</p>
                            </div>
                        </details>
                    </div>
                    <% } %>

                    <div class="profile-detail-full">
                        <span>Developer Access</span>
                        <p class="settings-hint">Developer access is separate from account type and includes God-level site permissions.</p>
                        <form class="login-form-actions settings-add-form" action="/settings/developer-access" method="POST">
                            <label for="developerDiscordId">Discord ID:</label>
                            <input type="text" id="developerDiscordId" name="discordId" required>
                            <input type="hidden" name="isDeveloper" value="true">
                            <button type="submit">Grant Access</button>
                        </form>
                        <% if (developers.length) { %>
                        <ul class="settings-list">
                            <% developers.forEach(function(developer) { %>
                            <li>
                                <span><%= developer.displayName || developer.discordUser || developer.login.discordId %> (<%= developer.login.discordId %>)</span>
                                <form action="/settings/developer-access" method="POST">
                                    <input type="hidden" name="discordId" value="<%= developer.login.discordId %>">
                                    <input type="hidden" name="isDeveloper" value="false">
                                    <button type="submit">Remove Access</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <% } %>
                    </div>

                    <div class="profile-detail-full">
                        <span>Ranks</span>
                        <p class="settings-hint">Name, sort order, and capacity (blank = unlimited slots).</p>
                        <ul class="settings-list">
                            <% settings.ranks.forEach(function(rank) { %>
                            <li>
                                <form class="login-form-actions settings-inline-form" action="/settings/update-option" method="POST">
                                    <input type="hidden" name="category" value="ranks">
                                    <input type="hidden" name="originalName" value="<%= rank.name %>">
                                    <input type="text" name="name" value="<%= rank.name %>" required>
                                    <input type="number" name="order" value="<%= rank.order %>" required>
                                    <input type="number" name="capacity" min="0" placeholder="Unlimited" value="<%= rank.capacity ?? '' %>">
                                    <button type="submit">Save</button>
                                </form>
                                <form action="/settings/delete-option" method="POST">
                                    <input type="hidden" name="category" value="ranks">
                                    <input type="hidden" name="name" value="<%= rank.name %>">
                                    <button type="submit">Delete</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <form class="login-form-actions settings-add-form" action="/settings/add-option" method="POST">
                            <input type="hidden" name="category" value="ranks">
                            <label for="newRankName">New Rank:</label>
                            <input type="text" id="newRankName" name="name" placeholder="Rank name" required>
                            <label for="newRankOrder">Sort Order:</label>
                            <input type="number" id="newRankOrder" name="order" value="<%= settings.ranks.length %>" required>
                            <label for="newRankCapacity">Capacity:</label>
                            <input type="number" id="newRankCapacity" name="capacity" min="0" placeholder="Unlimited">
                            <button type="submit">Add Rank</button>
                        </form>
                    </div>

                    <div class="profile-detail-full">
                        <span>Houses</span>
                        <p class="settings-hint">Name and roster row color.</p>
                        <ul class="settings-list">
                            <% settings.houses.forEach(function(house) { %>
                            <li>
                                <form class="login-form-actions settings-inline-form" action="/settings/update-option" method="POST">
                                    <input type="hidden" name="category" value="houses">
                                    <input type="hidden" name="originalName" value="<%= house.name %>">
                                    <input type="text" name="name" value="<%= house.name %>" required>
                                    <input type="color" name="color" value="<%= house.color %>">
                                    <button type="submit">Save</button>
                                </form>
                                <form action="/settings/delete-option" method="POST">
                                    <input type="hidden" name="category" value="houses">
                                    <input type="hidden" name="name" value="<%= house.name %>">
                                    <button type="submit">Delete</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <form class="login-form-actions settings-add-form" action="/settings/add-option" method="POST">
                            <input type="hidden" name="category" value="houses">
                            <label for="newHouseName">New House:</label>
                            <input type="text" id="newHouseName" name="name" placeholder="House name" required>
                            <label for="newHouseColor">Color:</label>
                            <input type="color" id="newHouseColor" name="color" value="#242320">
                            <button type="submit">Add House</button>
                        </form>
                    </div>

                    <div class="profile-detail-full">
                        <span>Shifts</span>
                        <p class="settings-hint">Name and roster row color.</p>
                        <ul class="settings-list">
                            <% settings.shifts.forEach(function(shift) { %>
                            <li>
                                <form class="login-form-actions settings-inline-form" action="/settings/update-option" method="POST">
                                    <input type="hidden" name="category" value="shifts">
                                    <input type="hidden" name="originalName" value="<%= shift.name %>">
                                    <input type="text" name="name" value="<%= shift.name %>" required>
                                    <input type="color" name="color" value="<%= shift.color %>">
                                    <button type="submit">Save</button>
                                </form>
                                <form action="/settings/delete-option" method="POST">
                                    <input type="hidden" name="category" value="shifts">
                                    <input type="hidden" name="name" value="<%= shift.name %>">
                                    <button type="submit">Delete</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <form class="login-form-actions settings-add-form" action="/settings/add-option" method="POST">
                            <input type="hidden" name="category" value="shifts">
                            <label for="newShiftName">New Shift:</label>
                            <input type="text" id="newShiftName" name="name" placeholder="Shift name" required>
                            <label for="newShiftColor">Color:</label>
                            <input type="color" id="newShiftColor" name="color" value="#242320">
                            <button type="submit">Add Shift</button>
                        </form>
                    </div>

                    <div class="profile-detail-full">
                        <span>Activities</span>
                        <p class="settings-hint">Name and roster row color.</p>
                        <ul class="settings-list">
                            <% settings.activities.forEach(function(activity) { %>
                            <li>
                                <form class="login-form-actions settings-inline-form" action="/settings/update-option" method="POST">
                                    <input type="hidden" name="category" value="activities">
                                    <input type="hidden" name="originalName" value="<%= activity.name %>">
                                    <input type="text" name="name" value="<%= activity.name %>" required>
                                    <input type="color" name="color" value="<%= activity.color %>">
                                    <button type="submit">Save</button>
                                </form>
                                <form action="/settings/delete-option" method="POST">
                                    <input type="hidden" name="category" value="activities">
                                    <input type="hidden" name="name" value="<%= activity.name %>">
                                    <button type="submit">Delete</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <form class="login-form-actions settings-add-form" action="/settings/add-option" method="POST">
                            <input type="hidden" name="category" value="activities">
                            <label for="newActivityName">New Activity:</label>
                            <input type="text" id="newActivityName" name="name" placeholder="Activity name" required>
                            <label for="newActivityColor">Color:</label>
                            <input type="color" id="newActivityColor" name="color" value="#242320">
                            <button type="submit">Add Activity</button>
                        </form>
                    </div>
                </div>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
    </body>
</html>
