<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Forgot Password | Drowsy Vocals</title>
    </head>
    <body class="<%= seasonalTheme === 'halloween' ? 'halloween-login-page' : (seasonalTheme === 'christmas' ? 'christmas-login-page' : '') %>">
        <main class="login-page">
            <section class="login-container">
                <div class="Logo">
                    <img src="/assets/drowsyNew.png" alt="Drowsy Vocals Logo">
                </div>
                <div class="login-form">
                    <% const successMessage = Array.isArray(success_msg) ? success_msg[0] : success_msg; %>
                    <% const errorMessage = Array.isArray(error_msg) ? error_msg[0] : error_msg; %>
                    <% if (successMessage) { %>
                    <div class="login-form-message is-success" role="status"><%= successMessage %></div>
                    <% } %>
                    <% if (errorMessage) { %>
                    <div class="login-form-message is-error" role="alert"><%= errorMessage %></div>
                    <% } %>
                    <form class="login-form-actions" action="/forgot-password" method="POST">
                        <label for="discordId">Discord ID:</label>
                        <input type="text" id="discordId" name="discordId" required>

                        <button type="submit">Send Reset Link</button>
                    </form>
                    <p class="login-help-note">We will send your reset link through DrowsyBot Discord DMs.</p>
                    <div class="login-helper-links">
                        <a href="/index?splash=1" class="login-help-link">Back to login</a>
                    </div>
                    <div class="footer">
                        <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
                    </div>
                </div>
            </section>
        </main>
    </body>
</html>
