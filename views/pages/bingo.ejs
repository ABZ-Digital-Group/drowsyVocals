<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Staff Bingo Board - Drowsy Vocals</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main class="bingo-page">
            <%
                const flattenedUsers = [];
                (groups || []).forEach(function(group) {
                    (group.users || []).forEach(function(user) {
                        flattenedUsers.push(user);
                    });
                });
                const currentBingoUser = flattenedUsers.find(function(user) {
                    return user && user.login && user.login.discordId === currentUserDiscordId;
                });
                const currentUserCanToggleCard = Boolean(currentBingoUser && currentBingoUser.login && currentBingoUser.login.discordId);
                const boardSize = 5;
                const boardSlots = boardSize * boardSize;
                const freeSlotIndex = 12;
                let goalCursor = 0;
                const bingoCardSlots = [];
                const fillerByPosition = Object.fromEntries((fillerSlots || []).map(function(slot) {
                    return [slot.position, slot];
                }));
                for (let slotIndex = 0; slotIndex < boardSlots; slotIndex += 1) {
                    if (slotIndex === freeSlotIndex) {
                        bingoCardSlots.push({ type: 'free', centerSlot });
                        continue;
                    }
                    if (fillerByPosition[slotIndex]) {
                        bingoCardSlots.push({ type: 'filler', filler: fillerByPosition[slotIndex] });
                        continue;
                    }
                    const goal = bingoGoals[goalCursor];
                    if (goal) {
                        const completed = Boolean(currentBingoUser && currentBingoUser.bingoProgress && currentBingoUser.bingoProgress[goal.id]);
                        bingoCardSlots.push({ type: 'goal', goal, completed });
                        goalCursor += 1;
                    } else {
                        bingoCardSlots.push({ type: 'empty' });
                    }
                }
                const currentCompletedGoals = currentBingoUser
                    ? bingoGoals.filter(function(goal) { return currentBingoUser.bingoProgress && currentBingoUser.bingoProgress[goal.id]; }).length
                    : 0;
                const playableGoalCount = bingoGoals.length;
                const currentCompletionPct = playableGoalCount ? Math.round((currentCompletedGoals / playableGoalCount) * 100) : 0;
            %>
            <!-- Header & Summary Area -->
            <div class="bingo-heading-wrap">
                <div class="bingo-heading-top">
                    <div>
                        <p class="profile-eyebrow">Gamification & Milestone Tracking</p>
                        <h1 style="margin: 0; font-size: 2.4em; color: #242320;">Staff Bingo Board</h1>
                        <p class="profile-subtitle">Weekly milestone targets for Drowsy Defenders and eligible staff ranks. Track completions, bonus House Points (HP), and Casino Coins (CC).</p>
                    </div>

                    <div class="bingo-actions-bar">
                        <div class="bingo-legend" aria-label="Bingo status legend">
                            <span class="bingo-legend-pill bingo-legend-complete">
                                <span class="material-symbols-outlined" style="font-size: 1.1em; background: transparent; color: inherit; padding: 0;">check_circle</span>
                                <span>Completed</span>
                            </span>
                            <span class="bingo-legend-pill bingo-legend-pending">
                                <span class="material-symbols-outlined" style="font-size: 1.1em; background: transparent; color: inherit; padding: 0;">schedule</span>
                                <span>Pending</span>
                            </span>
                        </div>

                        <% if (canManageBingo) { %>
                        <form action="/bingo/reset" method="POST" onsubmit="return confirm('⚠️ Are you sure you want to reset all Bingo milestones and totals for the new week?');" style="margin: 0;">
                            <button type="submit" class="settings-btn settings-btn-danger">
                                <span class="material-symbols-outlined">restart_alt</span>
                                <span>Reset Weekly Board</span>
                            </button>
                        </form>
                        <% } %>
                    </div>
                </div>

                <% if (canManageBingo) { %>
                <div class="bingo-template-management">
                    <%
                        const activeTemplateGoalsText = (bingoGoals || []).map(function(goal) {
                            const rewardValue = Number(goal.rewardValue);
                            const target = rewardValue && !/\d/.test(goal.target || '')
                                ? `${rewardValue} ${(goal.group || '').toUpperCase()}`.trim()
                                : goal.target;
                            return `${target} | ${goal.challenge || ('Complete: ' + target)}`;
                        }).join('\n');
                    %>
                    <details class="bingo-template-details">
                        <summary class="bingo-template-summary">
                            <span>
                                <span class="bingo-template-eyebrow">Template Management</span>
                                <span class="bingo-template-active">Active Template: <strong><%= activeBingoTemplateName %></strong></span>
                            </span>
                            <span class="material-symbols-outlined bingo-template-chevron" aria-hidden="true">expand_more</span>
                        </summary>
                        <div class="bingo-template-content">
                            <div class="bingo-template-activation">
                                <form action="/bingo/templates/activate" method="POST" onsubmit="return confirm('Switching bingo templates will reset all weekly bingo progress and totals. Continue?');">
                                    <select name="templateId" class="bingo-template-input" aria-label="Select active bingo template">
                                        <% bingoTemplates.forEach(function(template) { %>
                                        <option value="<%= template.id %>" <%= template.id === activeBingoTemplateId ? 'selected' : '' %>><%= template.name %> (<%= template.goals.length %> goals)</option>
                                        <% }); %>
                                    </select>
                                    <button type="submit" class="settings-btn settings-btn-secondary">
                                        <span class="material-symbols-outlined">swap_horiz</span>
                                        <span>Activate Template</span>
                                    </button>
                                </form>
                                <% const deletableBingoTemplates = bingoTemplates.filter(function(template) { return template.id !== 'default-weekly' && template.id !== 'halloween-edition'; }); %>
                                <% if (deletableBingoTemplates.length) { %>
                                <form action="/bingo/templates/delete" method="POST" onsubmit="return confirm('Delete this Bingo template and its uploaded images? This cannot be undone.');">
                                    <select name="templateId" class="bingo-template-input" aria-label="Select Bingo template to delete">
                                        <% deletableBingoTemplates.forEach(function(template) { %>
                                        <option value="<%= template.id %>"><%= template.name %> (<%= template.goals.length %> goals)</option>
                                        <% }); %>
                                    </select>
                                    <button type="submit" class="settings-btn settings-btn-danger">
                                        <span class="material-symbols-outlined">delete</span>
                                        <span>Delete Template</span>
                                    </button>
                                </form>
                                <% } %>
                            </div>

                    <form action="/bingo/templates/update" method="POST" enctype="multipart/form-data" class="bingo-template-form">
                        <input type="hidden" name="returnTo" value="/bingo">
                        <input type="hidden" name="templateId" value="<%= activeBingoTemplateId %>">
                        <div class="bingo-template-field">
                            <label for="activeTemplateName">Edit Active Template Name</label>
                            <input id="activeTemplateName" name="templateName" maxlength="80" required class="bingo-template-input" value="<%= activeBingoTemplateName %>">
                        </div>
                        <div class="bingo-template-field">
                            <label for="centerText">Centre space text</label>
                            <input id="centerText" name="centerText" maxlength="80" class="bingo-template-input" value="<%= centerSlot.text %>">
                        </div>
                        <div class="bingo-template-field">
                            <label for="centerImage">Centre space image (optional)</label>
                            <input id="centerImage" name="centerImage" type="file" accept="image/png,image/jpeg,image/webp" class="bingo-template-input">
                            <span>Uploading an image replaces the centre text. Leave empty to keep the current image.</span>
                            <% if (centerSlot.imageUrl) { %>
                            <label class="bingo-image-remove"><input type="checkbox" name="removeCenterImage" value="true"> Remove current centre image</label>
                            <% } %>
                        </div>
                        <div class="bingo-template-field">
                            <label for="activeGoalsText">Edit Active Template Goals</label>
                            <textarea id="activeGoalsText" name="goalsText" required rows="8" class="bingo-template-input"><%= activeTemplateGoalsText %></textarea>
                            <span>One goal per line using: <code>Target | Challenge description</code>.</span>
                        </div>
                        <div class="bingo-template-images">
                            <div class="bingo-template-image-heading">Image-only filler spaces (optional)</div>
                            <span>Upload an image directly into any card space. The centre position is reserved for the centre space.</span>
                            <div class="bingo-filler-position-grid">
                            <% const fillerColumnLabels = ['B', 'I', 'N', 'G', 'O']; %>
                            <% for (let position = 0; position < 25; position += 1) { if (position === 12) { %>
                            <div class="bingo-filler-position bingo-filler-position-centre">
                                <span>N3 · Centre</span>
                                <small>Use centre-space settings above</small>
                            </div>
                            <% } else {
                                const filler = (fillerSlots || []).find(function(slot) { return slot.position === position; });
                            %>
                            <label class="bingo-filler-position">
                                <span><%= fillerColumnLabels[position % 5] %><%= Math.floor(position / 5) + 1 %> · Space <%= position + 1 %></span>
                                <% if (filler) { %><img src="<%= filler.imageUrl %>" alt="Current filler image"><% } %>
                                <input type="file" name="fillerImages[<%= position %>]" accept="image/png,image/jpeg,image/webp" aria-label="Upload filler image for space <%= position + 1 %>">
                                <% if (filler) { %><span class="bingo-image-remove"><input type="checkbox" name="removeFillerPositions" value="<%= position %>"> Remove image</span><% } %>
                            </label>
                            <% } } %>
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="settings-btn settings-btn-secondary" onclick="return confirm('Update the active template with these new goals?');">
                                <span class="material-symbols-outlined">edit</span>
                                <span>Save Active Template Changes</span>
                            </button>
                        </div>
                    </form>

                    <form action="/bingo/templates" method="POST" enctype="multipart/form-data" class="bingo-template-form">
                        <div class="bingo-template-field">
                            <label for="templateName">Create New Template</label>
                            <input id="templateName" name="templateName" maxlength="80" required class="bingo-template-input" placeholder="Example: Halloween Week Board">
                        </div>
                        <div class="bingo-template-field">
                            <label for="newCenterText">Centre space text</label>
                            <input id="newCenterText" name="centerText" maxlength="80" class="bingo-template-input" value="FREE">
                        </div>
                        <div class="bingo-template-field">
                            <label for="newCenterImage">Centre space image (optional)</label>
                            <input id="newCenterImage" name="centerImage" type="file" accept="image/png,image/jpeg,image/webp" class="bingo-template-input">
                        </div>
                        <div class="bingo-template-field">
                            <label for="goalsText">Goals (one per line)</label>
                            <textarea id="goalsText" name="goalsText" required rows="8" class="bingo-template-input" placeholder="3 HP | Earn 3 House Points this week&#10;2500 CC | Collect 2,500 Casino Coins"></textarea>
                            <span>Use 1-30 lines. Format: <code>Target | Challenge description</code>. If challenge is omitted, it defaults to “Complete: Target”.</span>
                        </div>
                        <div>
                            <button type="submit" class="settings-btn settings-btn-primary">
                                <span class="material-symbols-outlined">add</span>
                                <span>Save Template</span>
                            </button>
                        </div>
                    </form>
                        </div>
                    </details>
                </div>
                <% } %>

                <!-- Top Stats Summary Bar -->
                <div class="settings-stats-bar" style="margin-top: 20px;">
                    <div class="settings-stat-item">
                        <span class="material-symbols-outlined settings-stat-icon" style="color: #60a5fa;">group</span>
                        <div class="settings-stat-info">
                            <span class="settings-stat-label">Eligible Staff</span>
                            <span class="settings-stat-val"><%= totalParticipants %> Members</span>
                        </div>
                    </div>

                    <div class="settings-stat-item">
                        <span class="material-symbols-outlined settings-stat-icon" style="color: #34d399;">task_alt</span>
                        <div class="settings-stat-info">
                            <span class="settings-stat-label">Milestones Completed</span>
                            <span class="settings-stat-val" style="color: #34d399;">
                                <%= totalCompletedTasks %> / <%= totalPossibleTasks %> <small style="font-size: 0.65em; color: #8e897e;">(<%= completionPercentage %>%)</small>
                            </span>
                        </div>
                    </div>

                    <div class="settings-stat-item">
                        <span class="material-symbols-outlined settings-stat-icon" style="color: #fbbf24;">military_tech</span>
                        <div class="settings-stat-info">
                            <span class="settings-stat-label">Total House Points</span>
                            <span class="settings-stat-val" style="color: #fbbf24;"><%= totalBingoHp %> HP</span>
                        </div>
                    </div>

                    <div class="settings-stat-item">
                        <span class="material-symbols-outlined settings-stat-icon" style="color: #a78bfa;">toll</span>
                        <div class="settings-stat-info">
                            <span class="settings-stat-label">Total Casino Coins</span>
                            <span class="settings-stat-val" style="color: #a78bfa;"><%= totalBingoCc %> CC</span>
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 20px;">
                    <span style="font-size: 0.86em; color: #8e897e; font-weight: bold;">
                        <% if (canManageBingo) { %>
                        💡 Admins can use the tracker table below. Everyone can use the new bingo card view.
                        <% } else { %>
                        💡 Click a square on your card to mark progress. Completed goals trigger confetti.
                        <% } %>
                    </span>
                </div>

                <section class="bingo-player-card-wrap" aria-label="Personal bingo card">
                    <div class="bingo-player-card-header">
                        <div>
                            <h2 style="margin: 0;">Your Weekly Bingo Card</h2>
                            <% if (currentBingoUser) { %>
                            <p style="margin: 6px 0 0; color: #9b9588; font-size: 0.88em;">
                                <%= currentBingoUser.displayName || currentBingoUser.discordUser || currentBingoUser.login.discordId %> ·
                                <%= currentBingoUser.accountType %>
                            </p>
                            <% } else { %>
                            <p style="margin: 6px 0 0; color: #9b9588; font-size: 0.88em;">
                                You are not currently in an eligible bingo rank (Drowsy Defender and below).
                            </p>
                            <% } %>
                        </div>
                        <div class="bingo-player-card-progress">
                            <span class="bingo-player-progress-fraction"><span id="bingoPlayerCompletedCount"><%= currentCompletedGoals %></span>/<span id="bingoPlayerTotalCount"><%= playableGoalCount %></span></span>
                            <span class="bingo-player-progress-pct" id="bingoPlayerProgressPct"><%= currentCompletionPct %>%</span>
                        </div>
                    </div>

                    <% if (currentBingoUser) { %>
                    <div class="bingo-player-grid" id="bingoPlayerGrid">
                        <div class="bingo-player-grid-head">B</div>
                        <div class="bingo-player-grid-head">I</div>
                        <div class="bingo-player-grid-head">N</div>
                        <div class="bingo-player-grid-head">G</div>
                        <div class="bingo-player-grid-head">O</div>
                        <% bingoCardSlots.forEach(function(slot, slotIndex) { %>
                            <% if (slot.type === 'free') { %>
                            <div class="bingo-player-cell is-free">
                                <% if (slot.centerSlot.imageUrl) { %>
                                <img class="bingo-goal-image" src="<%= slot.centerSlot.imageUrl %>" alt="<%= slot.centerSlot.text %>">
                                <% } else { %>
                                <span class="material-symbols-outlined bingo-player-cell-icon">star</span>
                                <span class="bingo-player-cell-title"><%= slot.centerSlot.text %></span>
                                <small class="bingo-player-cell-sub">Centre Space</small>
                                <% } %>
                            </div>
                            <% } else if (slot.type === 'filler') { %>
                            <div class="bingo-player-cell bingo-filler" aria-label="Decorative Bingo space">
                                <img class="bingo-goal-image" src="<%= slot.filler.imageUrl %>" alt="">
                            </div>
                            <% } else if (slot.type === 'goal') { %>
                            <div class="bingo-player-cell <%= slot.completed ? 'is-complete' : 'is-pending' %>" data-goal-id="<%= slot.goal.id %>" data-bingo-card-cell="true">
                                <% if (currentUserCanToggleCard) { %>
                                <form action="/bingo/toggle" method="POST" class="bingo-toggle-form bingo-player-toggle-form">
                                    <input type="hidden" name="discordId" value="<%= currentBingoUser.login.discordId %>">
                                    <input type="hidden" name="goalId" value="<%= slot.goal.id %>">
                                    <button type="submit" class="bingo-player-cell-btn" title="Goal <%= slot.goal.label %>: <%= slot.goal.target %> — <%= slot.goal.challenge || ('Complete: ' + slot.goal.target) %>">
                                        <span class="material-symbols-outlined bingo-goal-icon"><%= slot.completed ? 'check_circle' : 'circle' %></span>
                                        <span class="bingo-player-cell-title"><%= slot.goal.target %></span>
                                        <small class="bingo-player-cell-sub"><%= slot.goal.challenge || ('Complete: ' + slot.goal.target) %></small>
                                    </button>
                                </form>
                                <% } else { %>
                                <div class="bingo-player-cell-static" title="Goal <%= slot.goal.label %>: <%= slot.goal.target %> — <%= slot.goal.challenge || ('Complete: ' + slot.goal.target) %>">
                                    <span class="material-symbols-outlined bingo-goal-icon"><%= slot.completed ? 'check_circle' : 'circle' %></span>
                                    <span class="bingo-player-cell-title"><%= slot.goal.target %></span>
                                    <small class="bingo-player-cell-sub"><%= slot.goal.challenge || ('Complete: ' + slot.goal.target) %></small>
                                </div>
                                <% } %>
                            </div>
                            <% } else { %>
                            <div class="bingo-player-cell is-empty" aria-hidden="true"></div>
                            <% } %>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div class="bingo-player-empty-state">
                        <span class="material-symbols-outlined">info</span>
                        <span>You currently do not have a personal bingo card available in this week&apos;s eligible ranks.</span>
                    </div>
                    <% } %>
                </section>

                <div class="bingo-challenge-guide" aria-label="Bingo challenge guide">
                    <div class="bingo-challenge-guide-header">
                        <span class="material-symbols-outlined">task</span>
                        <span>Goal Challenge Guide</span>
                    </div>
                    <div class="bingo-challenge-grid">
                        <% bingoGoals.forEach(function(goal) { %>
                        <article class="bingo-challenge-item">
                            <div class="bingo-challenge-item-top">
                                <span class="bingo-challenge-badge">Goal <%= goal.label %></span>
                                <span class="bingo-challenge-target"><%= goal.target %></span>
                            </div>
                            <p class="bingo-challenge-text"><%= goal.challenge || ('Complete: ' + goal.target) %></p>
                        </article>
                        <% }); %>
                    </div>
                </div>

                <% if (canManageBingo) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 22px;">
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; flex: 1;">
                        <input type="search" id="bingoSearchInput" class="bingo-search-input" placeholder="🔍 Filter staff by name..." aria-label="Search staff members">
                        <select id="bingoRankFilter" class="bingo-search-input" style="min-width: 180px;">
                            <option value="">All Ranks</option>
                            <% groups.forEach(function(group) { %>
                            <option value="<%= group.name.toLowerCase() %>"><%= group.name %></option>
                            <% }); %>
                        </select>
                    </div>

                    <span style="font-size: 0.85em; color: #8e897e; font-weight: bold;">
                        🛠️ Admin tracker view: bulk monitor and edit all staff progress.
                    </span>
                </div>
                <% } %>
            </div>

            <!-- Flash Message Alerts -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
            <div class="settings-alert is-success" style="margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="background: transparent; color: #10b981;">check_circle</span>
                    <span><%= success_msg %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
            </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
            <div class="settings-alert is-error" style="margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="background: transparent; color: #ef4444;">error</span>
                    <span><%= error_msg %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
            </div>
            <% } %>

            <!-- Interactive Board Container (Admins Only) -->
            <% if (canManageBingo) { %>
            <section class="bingo-admin-tracker" aria-label="Admin bingo tracker">
                <% if (!groups || groups.length === 0) { %>
                <div class="bingo-admin-empty">
                    No staff members currently in eligible bingo ranks (Drowsy Defender and below).
                </div>
                <% } else { %>
                <% groups.forEach(function(group) { %>
                <section class="bingo-admin-group" data-rank-group="<%= group.name.toLowerCase() %>">
                    <header class="bingo-admin-rank-header">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 1.2em; color: #fbbf24; background: transparent; padding: 0;">military_tech</span>
                            <span><%= group.name %></span>
                        </div>
                        <span style="font-size: 0.8em; color: #8e897e; font-weight: normal;"><%= group.users.length %> member<%= group.users.length === 1 ? '' : 's' %></span>
                    </header>
                    <div class="bingo-admin-list">
                        <% group.users.forEach(function(user) {
                            const completedCount = bingoGoals.filter(g => !g.imageUrl && user.bingoProgress && user.bingoProgress[g.id]).length;
                            const percent = playableBingoGoalCount ? Math.round((completedCount / playableBingoGoalCount) * 100) : 0;
                            const userSearchText = `${user.displayName || ''} ${user.discordUser || ''} ${user.login.discordId} ${user.accountType || ''} ${user.house || ''}`.toLowerCase();
                        %>
                        <details class="bingo-admin-card bingo-user-row" data-search="<%= userSearchText %>" data-rank="<%= (user.accountType || '').toLowerCase() %>" data-discord-id="<%= user.login.discordId %>">
                            <summary class="bingo-admin-toggle" aria-expanded="false">
                                <div class="bingo-admin-summary-main">
                                    <%- include('../partials/avatar', {
                                        avatarUrl: user.avatarUrl,
                                        displayName: user.displayName || user.discordUser || user.login.discordId,
                                        discordId: user.login.discordId,
                                        size: 38,
                                        online: false
                                    }) %>
                                    <div class="bingo-admin-summary-names">
                                        <span class="bingo-member-display"><%= user.displayName || user.discordUser || user.login.discordId %></span>
                                        <div class="bingo-member-sub">
                                            <span>@<%= user.discordUser || user.login.discordId %></span>
                                            <span>·</span>
                                            <span><%= user.accountType %></span>
                                            <% if (user.house) { %>
                                            <span>·</span>
                                            <span style="color: <%= houseColorMap[user.house] || '#8e897e' %>; font-weight: bold;"><%= user.house %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="bingo-admin-summary-right">
                                    <div class="bingo-admin-progress-wrap">
                                        <div class="bingo-progress-labels">
                                            <span class="bingo-progress-fraction"><%= completedCount %>/<%= playableBingoGoalCount %></span>
                                            <span class="bingo-progress-pct" style="color: <%= percent === 100 ? '#34d399' : percent >= 50 ? '#fbbf24' : '#8e897e' %>;"><%= percent %>%</span>
                                        </div>
                                        <div class="bingo-progress-bar">
                                            <div class="bingo-progress-fill" style="width: <%= percent %>%;"></div>
                                        </div>
                                    </div>
                                    <span class="material-symbols-outlined bingo-admin-chevron">expand_more</span>
                                </div>
                            </summary>

                            <div class="bingo-admin-details" hidden>
                                <div class="bingo-admin-goals-grid">
                                    <% bingoGoals.forEach(function(goal) {
                                        const completed = Boolean(user.bingoProgress && user.bingoProgress[goal.id]);
                                        const rewardMatch = (goal.target || '').match(/-?\d[\d,]*/);
                                        const rewardValue = rewardMatch ? Number((rewardMatch[0] || '0').replace(/,/g, '')) || 0 : 0;
                                    %>
                                    <div class="bingo-cell <%= completed ? 'is-complete' : 'is-pending' %>" data-goal-id="<%= goal.id %>" data-goal-group="<%= goal.group %>" data-goal-value="<%= rewardValue %>">
                                        <form action="/bingo/toggle" method="POST" class="bingo-toggle-form" style="margin: 0;">
                                            <input type="hidden" name="discordId" value="<%= user.login.discordId %>">
                                            <input type="hidden" name="goalId" value="<%= goal.id %>">
                                            <button type="submit" class="bingo-goal-btn" title="Goal <%= goal.label %>">
                                                <span class="material-symbols-outlined bingo-goal-icon"><%= completed ? 'check_circle' : 'circle' %></span>
                                                <span>Goal <%= goal.label %></span>
                                            </button>
                                        </form>
                                    </div>
                                    <% }); %>
                                </div>
                                <div class="bingo-admin-totals-row">
                                    <label class="bingo-total-cell">
                                        <span class="bingo-admin-total-label">Total HP</span>
                                        <div class="bingo-total-box">
                                            <input type="text" value="<%= user.calculatedBingoTotals?.hp ?? 0 %>" data-discord-id="<%= user.login.discordId %>" aria-label="Total HP for <%= user.displayName || user.login.discordId %>" class="bingo-total-input bingo-hp-input" title="Total House Points for this Bingo card">
                                        </div>
                                    </label>
                                    <label class="bingo-total-cell">
                                        <span class="bingo-admin-total-label">Total CC</span>
                                        <div class="bingo-total-box">
                                            <input type="text" value="<%= user.calculatedBingoTotals?.cc ?? 0 %>" data-discord-id="<%= user.login.discordId %>" aria-label="Total CC for <%= user.displayName || user.login.discordId %>" class="bingo-total-input bingo-cc-input" title="Total Casino Coins for this Bingo card">
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </details>
                        <% }); %>
                    </div>
                </section>
                <% }); %>
                <% } %>
            </section>
            <% } %>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>

        <script>
            // Instant Search & Rank Filter
            const searchInput = document.getElementById('bingoSearchInput');
            const rankFilter = document.getElementById('bingoRankFilter');
            const rows = document.querySelectorAll('.bingo-user-row');
            const adminGroups = document.querySelectorAll('.bingo-admin-group');

            function applyBingoFilters() {
                if (!rows.length) return;
                const query = (searchInput?.value || '').toLowerCase().trim();
                const selectedRank = (rankFilter?.value || '').toLowerCase().trim();

                rows.forEach(row => {
                    const searchData = row.dataset.search || '';
                    const rankData = row.dataset.rank || '';
                    const matchesSearch = !query || searchData.includes(query);
                    const matchesRank = !selectedRank || rankData === selectedRank;

                    row.style.display = (matchesSearch && matchesRank) ? '' : 'none';
                });

                // Hide rank groups if all child rows in that rank are hidden
                adminGroups.forEach(group => {
                    const groupRank = group.dataset.rankGroup;
                    const visibleChildren = Array.from(rows).some(r => r.dataset.rank === groupRank && r.style.display !== 'none');
                    group.style.display = visibleChildren ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', applyBingoFilters);
            if (rankFilter) rankFilter.addEventListener('change', applyBingoFilters);

            document.querySelectorAll('.bingo-admin-card').forEach(card => {
                const toggle = card.querySelector('.bingo-admin-toggle');
                const details = card.querySelector('.bingo-admin-details');
                if (!toggle || !details) return;

                const syncCardState = () => {
                    const isOpen = card.open;
                    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    details.hidden = !isOpen;
                    card.classList.toggle('is-open', isOpen);
                };

                syncCardState();
                card.addEventListener('toggle', syncCardState);
            });

            function setGoalCellState(cell, icon, isComplete) {
                if (!cell) return;
                cell.classList.toggle('is-complete', isComplete);
                cell.classList.toggle('is-pending', !isComplete);
                if (icon) icon.textContent = isComplete ? 'check_circle' : 'circle';
            }

            let activeConfettiCanvas = null;
            function launchConfetti(origin = null) {
                const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (reducedMotion) return;

                if (activeConfettiCanvas) {
                    activeConfettiCanvas.remove();
                    activeConfettiCanvas = null;
                }

                const canvas = document.createElement('canvas');
                canvas.style.position = 'fixed';
                canvas.style.inset = '0';
                canvas.style.width = '100vw';
                canvas.style.height = '100vh';
                canvas.style.pointerEvents = 'none';
                canvas.style.zIndex = '9999';
                document.body.appendChild(canvas);
                activeConfettiCanvas = canvas;

                const context = canvas.getContext('2d');
                if (!context) {
                    canvas.remove();
                    activeConfettiCanvas = null;
                    return;
                }

                const resizeCanvas = () => {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                };
                resizeCanvas();
                window.addEventListener('resize', resizeCanvas, { once: true });

                const colors = ['#fbbf24', '#34d399', '#60a5fa', '#fb7185', '#a78bfa', '#f97316', '#22d3ee', '#f43f5e'];
                const centerX = origin?.x ?? (canvas.width * (0.4 + Math.random() * 0.2));
                const centerY = origin?.y ?? (canvas.height * (0.35 + Math.random() * 0.15));
                const particles = [];

                const createBurst = (burstOriginX, burstOriginY, count, spread, power) => {
                    for (let i = 0; i < count; i += 1) {
                        const angle = (-Math.PI / 2) + ((Math.random() - 0.5) * spread);
                        const speed = power * (0.6 + Math.random() * 0.8);
                        const type = Math.random() < 0.25 ? 'streamer' : 'square';
                        particles.push({
                            x: burstOriginX,
                            y: burstOriginY,
                            vx: Math.cos(angle) * speed,
                            vy: Math.sin(angle) * speed,
                            gravity: 0.12 + Math.random() * 0.08,
                            drag: 0.992 + Math.random() * 0.004,
                            wobble: Math.random() * Math.PI * 2,
                            wobbleSpeed: 0.08 + Math.random() * 0.14,
                            rotation: Math.random() * Math.PI * 2,
                            rotationSpeed: (Math.random() - 0.5) * 0.32,
                            size: type === 'streamer' ? (6 + Math.random() * 8) : (4 + Math.random() * 6),
                            length: type === 'streamer' ? (12 + Math.random() * 12) : null,
                            color: colors[Math.floor(Math.random() * colors.length)],
                            life: 110 + Math.floor(Math.random() * 45),
                            type
                        });
                    }
                };

                createBurst(centerX, centerY, 130, Math.PI * 1.2, 8.8);
                createBurst(centerX - 80, centerY + 20, 65, Math.PI, 7.8);
                createBurst(centerX + 80, centerY + 20, 65, Math.PI, 7.8);

                let frame = 0;
                const totalFrames = 170;

                const animate = () => {
                    context.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach((particle) => {
                        particle.vx *= particle.drag;
                        particle.vy = (particle.vy * particle.drag) + particle.gravity;
                        particle.x += particle.vx;
                        particle.y += particle.vy;
                        particle.wobble += particle.wobbleSpeed;
                        particle.rotation += particle.rotationSpeed;
                        particle.life -= 1;

                        const alpha = Math.max(0, particle.life / totalFrames);
                        const drawX = particle.x + Math.cos(particle.wobble) * 2;
                        const drawY = particle.y + Math.sin(particle.wobble) * 1.4;

                        context.save();
                        context.globalAlpha = alpha;
                        context.translate(drawX, drawY);
                        context.rotate(particle.rotation);
                        context.fillStyle = particle.color;

                        if (particle.type === 'streamer') {
                            context.fillRect(-particle.size * 0.2, -particle.length * 0.5, particle.size * 0.4, particle.length);
                        } else {
                            context.fillRect(-particle.size * 0.5, -particle.size * 0.5, particle.size, particle.size * 0.75);
                        }
                        context.restore();
                    });

                    frame += 1;
                    if (frame < totalFrames) {
                        requestAnimationFrame(animate);
                    } else {
                        canvas.remove();
                        if (activeConfettiCanvas === canvas) activeConfettiCanvas = null;
                    }
                };

                requestAnimationFrame(animate);
            }

            // AJAX Toggle for Bingo Buttons (Instant UI response without page reload)
            document.querySelectorAll('.bingo-toggle-form').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const cell = form.closest('.bingo-cell, .bingo-player-cell');
                    const row = form.closest('.bingo-user-row');
                    const btn = form.querySelector('.bingo-goal-btn');
                    const icon = btn?.querySelector('.bingo-goal-icon');
                    const cardButton = form.querySelector('.bingo-player-cell-btn');
                    const cardIcon = cardButton?.querySelector('.bingo-goal-icon');
                    const activeButton = btn || cardButton;
                    const activeIcon = icon || cardIcon;
                    
                    const discordId = form.querySelector('input[name="discordId"]')?.value;
                    const goalId = form.querySelector('input[name="goalId"]')?.value;
                    if (!discordId || !goalId) return form.submit();

                    // Optimistic UI toggle
                    const currentlyComplete = cell.classList.contains('is-complete');
                    const nextComplete = !currentlyComplete;

                    setGoalCellState(cell, activeIcon, nextComplete);

                    // Update row progress calculation
                    updateRowProgress(row);
                    updatePlayerCardProgress();

                    try {
                        const response = await fetch('/bingo/toggle', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: new URLSearchParams({ discordId, goalId }).toString()
                        });

                        if (!response.ok) throw new Error(`Toggle failed: ${response.status}`);
                        const payload = await response.json().catch(() => null);
                        const serverCompleted = typeof payload?.completed === 'boolean' ? payload.completed : nextComplete;

                        setGoalCellState(cell, activeIcon, serverCompleted);
                        updateRowProgress(row);
                        updatePlayerCardProgress();
                        if (serverCompleted && !currentlyComplete) {
                            const rect = activeButton?.getBoundingClientRect();
                            launchConfetti(rect ? { x: rect.left + (rect.width / 2), y: rect.top + (rect.height / 2) } : null);
                        }
                    } catch (err) {
                        console.error('Failed to toggle bingo goal:', err);
                        setGoalCellState(cell, activeIcon, currentlyComplete);
                        updateRowProgress(row);
                        updatePlayerCardProgress();
                    }
                });
            });

            function updateRowProgress(row) {
                if (!row) return;
                const totalGoals = row.querySelectorAll('.bingo-cell:not(.bingo-filler)').length || 1;
                const completedGoals = row.querySelectorAll('.bingo-cell.is-complete').length;
                const pct = Math.round((completedGoals / totalGoals) * 100);

                const fractionEl = row.querySelector('.bingo-progress-fraction');
                const pctEl = row.querySelector('.bingo-progress-pct');
                const fillEl = row.querySelector('.bingo-progress-fill');

                if (fractionEl) fractionEl.textContent = `${completedGoals}/${totalGoals}`;
                if (pctEl) {
                    pctEl.textContent = `${pct}%`;
                    pctEl.style.color = pct === 100 ? '#34d399' : pct >= 50 ? '#fbbf24' : '#8e897e';
                }
                if (fillEl) fillEl.style.width = `${pct}%`;

                const completedCells = row.querySelectorAll('.bingo-cell.is-complete');
                let hpTotal = 0;
                let ccTotal = 0;
                completedCells.forEach((cell) => {
                    const value = Number(cell.dataset.goalValue || 0) || 0;
                    const group = (cell.dataset.goalGroup || '').toLowerCase();
                    if (group === 'hp') hpTotal += value;
                    if (group === 'cc') ccTotal += value;
                });
                const hpInput = row.querySelector('.bingo-hp-input');
                const ccInput = row.querySelector('.bingo-cc-input');
                if (hpInput) hpInput.value = String(hpTotal);
                if (ccInput) ccInput.value = String(ccTotal);
            }

            function updatePlayerCardProgress() {
                const grid = document.getElementById('bingoPlayerGrid');
                if (!grid) return;
                const goalCells = grid.querySelectorAll('.bingo-player-cell[data-goal-id]');
                const totalGoals = goalCells.length;
                const completedGoals = grid.querySelectorAll('.bingo-player-cell.is-complete[data-goal-id]').length;
                const pct = totalGoals > 0 ? Math.round((completedGoals / totalGoals) * 100) : 0;
                const completedEl = document.getElementById('bingoPlayerCompletedCount');
                const totalEl = document.getElementById('bingoPlayerTotalCount');
                const pctEl = document.getElementById('bingoPlayerProgressPct');
                if (completedEl) completedEl.textContent = `${completedGoals}`;
                if (totalEl) totalEl.textContent = `${totalGoals}`;
                if (pctEl) pctEl.textContent = `${pct}%`;
            }
        </script>
    </body>
</html>