<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('../partials/head') %>
		<title>Drowsy Feedback</title>
	</head>
	<body>
		<header><%- include('../partials/nav') %></header>
		<main>
			<section class="profile-page">
				<div class="profile-heading">
					<p class="profile-eyebrow">Community</p>
					<h1>Feedback</h1>
					<p class="profile-subtitle">Share feedback to help improve the server.</p>
				</div>
				<div class="profile-details">
					<div class="profile-detail-full">
						<span>Send Feedback</span>
						<form class="login-form-actions" action="/feedback" method="POST">
							<label for="feedbackContent">Your feedback</label>
							<textarea id="feedbackContent" name="content" rows="7" maxlength="5000" required></textarea>
							<button type="submit">Submit Feedback</button>
						</form>
					</div>
					<% if (canViewFeedback) { %>
					<div class="profile-detail-full">
						<span>Submitted Feedback</span>
						<% if (feedbackEntries.length === 0) { %>
						<strong>No feedback submitted yet.</strong>
						<% } else { %>
						<ul class="feedback-list">
							<% feedbackEntries.forEach(function(entry) { %>
							<li>
								<div class="feedback-entry-meta">
									<strong><%= entry.submittedBy %></strong>
									<div class="feedback-entry-actions">
										<small><%= (entry.submittedAt || '').slice(0, 10) %></small>
										<form action="/feedback/<%= entry._id %>/delete" method="POST" onsubmit="return confirm('Delete this feedback response?');">
											<button class="feedback-delete-button" type="submit" aria-label="Delete feedback from <%= entry.submittedBy %>">
												<span class="material-symbols-outlined" aria-hidden="true">delete</span>
												Delete
											</button>
										</form>
									</div>
								</div>
								<p><%= entry.content %></p>
								<form class="feedback-workflow" action="/feedback/<%= entry._id %>/update" method="POST">
									<label>Status
										<select name="status">
											<% ['New', 'Reviewed', 'Resolved'].forEach(function(status) { %>
											<option value="<%= status %>" <%= (entry.status || 'New') === status ? 'selected' : '' %>><%= status %></option>
											<% }); %>
										</select>
									</label>
									<label>Manager note
										<textarea name="managerNote" rows="2" maxlength="2000" placeholder="Internal note"><%= entry.managerNote || '' %></textarea>
									</label>
									<button type="submit">Save review</button>
								</form>
							</li>
							<% }); %>
						</ul>
						<% } %>
					</div>
					<% } %>
					<% if (canViewEventFeedback) { %>
					<div class="profile-detail-full event-feedback-review">
						<span>Event Feedback</span>
						<% if (eventFeedbackEntries.length === 0) { %>
						<strong>No event feedback submitted yet.</strong>
						<% } else { %>
						<ul class="feedback-list">
							<% eventFeedbackEntries.forEach(function(entry) { %>
							<li>
								<div class="feedback-entry-meta">
									<strong><%= entry.submittedBy %></strong>
									<div class="feedback-entry-actions">
										<small><%= (entry.submittedAt || '').slice(0, 10) %></small>
										<form action="/event-feedback/<%= entry._id %>/delete" method="POST" onsubmit="return confirm('Delete this event feedback response?');">
											<button class="feedback-delete-button" type="submit" aria-label="Delete event feedback from <%= entry.submittedBy %>">
												<span class="material-symbols-outlined" aria-hidden="true">delete</span>
												Delete
											</button>
										</form>
									</div>
								</div>
								<div class="event-feedback-summary">
									<strong><%= entry.overallRating %></strong>
									<span><%= entry.attendance %> likely to attend again</span>
								</div>
								<dl class="event-feedback-answers">
									<div><dt>Enjoyment</dt><dd><%= entry.enjoyment %></dd></div>
									<div><dt>Organisation</dt><dd><%= entry.organisation %></dd></div>
									<div><dt>Hosts and staff</dt><dd><%= entry.hosts %></dd></div>
									<div><dt>Issues</dt><dd><%= entry.issues %></dd></div>
								</dl>
								<% if (entry.enjoyedWhat || entry.improve || entry.issueDetails || entry.anythingElse) { %>
								<div class="event-feedback-comments">
									<% if (entry.enjoyedWhat) { %><p><strong>Enjoyed:</strong> <%= entry.enjoyedWhat %></p><% } %>
									<% if (entry.improve) { %><p><strong>Improve:</strong> <%= entry.improve %></p><% } %>
									<% if (entry.issueDetails) { %><p><strong>Issue details:</strong> <%= entry.issueDetails %></p><% } %>
									<% if (entry.anythingElse) { %><p><strong>Additional comments:</strong> <%= entry.anythingElse %></p><% } %>
								</div>
								<% } %>
							</li>
							<% }); %>
						</ul>
						<% } %>
					</div>
					<% } %>
				</div>
			</section>
		</main>
		<div class="footer"><p>&copy; 2026 Drowsy Vocals | All rights reserved.</p></div>
	</body>
</html>
