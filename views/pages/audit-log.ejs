<!DOCTYPE html>
<html lang="en">
    <head><%- include('../partials/head') %><title>Audit Log</title></head>
    <body>
        <header><%- include('../partials/nav') %></header>
        <main><section class="profile-page"><div class="profile-heading"><p class="profile-eyebrow">Management</p><h1>Audit Log</h1><p class="profile-subtitle">Recent management activity across the site.</p></div>
            <ul class="audit-log"><% if (!entries.length) { %><li>No management activity has been recorded yet.</li><% } %><% entries.forEach(function(entry) { %><li><strong><%= entry.action %></strong><span><%= entry.detail %></span><small><%= entry.actor %> · <%= (entry.createdAt || '').replace('T', ' ') %></small></li><% }); %></ul>
        </section></main>
        <div class="footer"><p>&copy; 2026 Drowsy Vocals | All rights reserved.</p></div>
    </body>
</html>
