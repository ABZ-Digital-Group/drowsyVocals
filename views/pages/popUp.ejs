<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('../partials/head') %>
		<title>Pop-up Events - Drowsy Vocals</title>
	</head>
	<body>
		<header><%- include('../partials/nav') %></header>
		<main>
			<section class="settings-page">
				<div class="settings-header">
					<p class="profile-eyebrow">Community Programming</p>
					<h1 style="margin: 0; font-size: 2.4em; color: #242320;">Pop-up Events</h1>
					<p class="profile-subtitle">One-off events, special announcements, and spontaneous community activities.</p>
					<div class="settings-stats-bar">
						<div class="settings-stat-item">
							<span class="material-symbols-outlined settings-stat-icon" style="color: #fbbf24;">bolt</span>
							<div class="settings-stat-info"><span class="settings-stat-label">Upcoming Pop-ups</span><span class="settings-stat-val" style="color: #fbbf24;"><%= upcomingEvents.length %> Scheduled</span></div>
						</div>
						<div class="settings-stat-item">
							<span class="material-symbols-outlined settings-stat-icon" style="color: #34d399;">event_available</span>
							<div class="settings-stat-info"><span class="settings-stat-label">Completed</span><span class="settings-stat-val"><%= pastEvents.length %> Archived</span></div>
						</div>
					</div>
				</div>

				<% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
				<div class="settings-alert is-success"><span><%= success_msg %></span><button type="button" onclick="this.parentElement.remove()">&times;</button></div>
				<% } %>
				<% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
				<div class="settings-alert is-error"><span><%= error_msg %></span><button type="button" onclick="this.parentElement.remove()">&times;</button></div>
				<% } %>

				<div class="account-grid">
					<div class="account-column">
						<div class="account-card">
							<div class="account-card-header"><h3 class="account-card-title"><span class="material-symbols-outlined">bolt</span><span>Upcoming Pop-up Events</span></h3><span class="account-badge"><%= upcomingEvents.length %> Upcoming</span></div>
							<% if (!upcomingEvents.length) { %>
							<div style="background: #1a1917; border: 1px solid #383734; border-radius: 6px; padding: 36px 16px; text-align: center; color: #8e897e;"><span class="material-symbols-outlined" style="font-size: 2.8em; color: #6f6a60;">event_busy</span><h4 style="margin: 8px 0 4px; color: #f3efe6;">No Pop-up Events Scheduled</h4><p style="margin: 0; font-size: .85em;">Special events will appear here once scheduled.</p></div>
							<% } else { %>
							<div style="display: flex; flex-direction: column; gap: 14px;">
								<% upcomingEvents.forEach(function(event) { %>
								<article style="background: #1a1917; border: 1px solid #383734; border-left: 4px solid #fbbf24; border-radius: 6px; padding: 18px;">
									<div style="display: flex; justify-content: space-between; gap: 12px; align-items: flex-start;">
										<div><h4 style="margin: 0; color: #f3efe6; font-size: 1.2em;"><%= event.title %></h4><span style="display: block; margin-top: 5px; color: #8e897e;">📍 <%= event.location || 'Discord' %></span></div>
										<time style="color: #fbbf24; font-weight: bold; text-align: right; white-space: nowrap;"><%= new Date(event.scheduledStartTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></time>
									</div>
									<% if (event.description) { %><p style="margin: 12px 0 0; color: #d0cdc5; line-height: 1.5; white-space: pre-wrap;"><%= event.description %></p><% } %>
									<% if (isManager) { %>
									<div style="display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid #282724; padding-top: 10px; margin-top: 12px;"><button type="button" class="settings-btn settings-btn-secondary settings-btn-sm editPopupBtn" data-id="<%= event.id || event._id %>" data-title="<%= event.title %>" data-location="<%= event.location || 'Discord' %>" data-description="<%= event.description || '' %>" data-start="<%= event.scheduledStartTime %>" data-end="<%= event.scheduledEndTime || '' %>"><span class="material-symbols-outlined">edit</span>Edit</button><form action="/pop-up/<%= event.id || event._id %>/delete" method="POST" onsubmit="return confirm('Remove this pop-up event?')"><button type="submit" class="settings-btn settings-btn-danger settings-btn-sm"><span class="material-symbols-outlined">delete</span>Delete</button></form></div>
									<% } %>
								</article>
								<% }); %>
							</div>
							<% } %>
						</div>
						<% if (pastEvents.length) { %><details class="settings-accordion"><summary><span class="material-symbols-outlined">history</span><span>Past Pop-up Events (<%= pastEvents.length %>)</span></summary><div class="settings-accordion-content"><% pastEvents.forEach(function(event) { %><div style="padding: 10px 0; border-bottom: 1px solid #333;"><strong style="color: #d0cdc5;"><%= event.title %></strong><span style="display: block; color: #8e897e; font-size: .8em;"><%= new Date(event.scheduledStartTime).toLocaleString() %> · <%= event.location || 'Discord' %></span></div><% }); %></div></details><% } %>
					</div>

					<div class="account-column"><% if (isManager) { %>
						<div class="account-card"><div class="account-card-header"><h3 class="account-card-title"><span class="material-symbols-outlined">add_circle</span><span>Schedule Pop-up Event</span></h3><span class="account-badge">Manager Tool</span></div>
							<form class="account-form popup-event-form" action="/pop-up/create" method="POST"><input type="hidden" name="startIso"><input type="hidden" name="endIso">
								<label for="popupTitle">Event Title</label><input id="popupTitle" name="title" class="settings-input" placeholder="e.g. Surprise Karaoke Night" required>
								<label for="popupLocation">Location</label><input id="popupLocation" name="location" class="settings-input" value="Discord" required>
								<label for="popupStart">Start</label><input id="popupStart" class="settings-input popup-start" type="datetime-local" required>
								<label for="popupEnd">End (Optional)</label><input id="popupEnd" class="settings-input popup-end" type="datetime-local">
								<label for="popupDescription">Description / Rules</label><textarea id="popupDescription" name="description" class="settings-textarea" rows="4" placeholder="Share the details for this special event..."></textarea>
								<button type="submit" class="account-btn account-btn-primary"><span class="material-symbols-outlined">bolt</span>Schedule Pop-up</button>
							</form>
						</div>
					<% } else { %><div class="account-card"><div class="account-card-header"><h3 class="account-card-title"><span class="material-symbols-outlined">info</span><span>About Pop-up Events</span></h3></div><p style="margin: 0; color: #d0cdc5; line-height: 1.6;">Pop-up events are special activities announced for a limited time. Check this page for the latest details and times.</p></div><% } %></div>
				</div>
			</section>
		</main>

		<% if (isManager) { %><dialog id="editPopupDialog" class="dialog-wide"><form class="account-form popup-event-form" id="editPopupForm" method="POST"><h3>Edit Pop-up Event</h3><input type="hidden" name="startIso"><input type="hidden" name="endIso"><label>Event Title</label><input name="title" class="settings-input" required><label>Location</label><input name="location" class="settings-input" required><label>Start</label><input class="settings-input popup-start" type="datetime-local" required><label>End (Optional)</label><input class="settings-input popup-end" type="datetime-local"><label>Description / Rules</label><textarea name="description" class="settings-textarea" rows="4"></textarea><div class="dialog-buttons"><button type="submit">Save Changes</button><button type="button" id="closeEditPopup">Cancel</button></div></form></dialog><% } %>
		<script>
			document.querySelectorAll('.popup-event-form').forEach((form) => {
				form.addEventListener('submit', () => {
					const start = form.querySelector('.popup-start');
					const end = form.querySelector('.popup-end');
					form.querySelector('[name="startIso"]').value = start.value ? new Date(start.value).toISOString() : '';
					form.querySelector('[name="endIso"]').value = end.value ? new Date(end.value).toISOString() : '';
				});
			});
			document.querySelectorAll('.editPopupBtn').forEach((button) => button.addEventListener('click', () => {
				const dialog = document.getElementById('editPopupDialog');
				const form = document.getElementById('editPopupForm');
				form.action = `/pop-up/${button.dataset.id}/update`;
				form.title.value = button.dataset.title;
				form.location.value = button.dataset.location;
				form.description.value = button.dataset.description;
				form.querySelector('.popup-start').value = new Date(button.dataset.start).toISOString().slice(0, 16);
				form.querySelector('.popup-end').value = button.dataset.end ? new Date(button.dataset.end).toISOString().slice(0, 16) : '';
				dialog.showModal();
			}));
			document.getElementById('closeEditPopup')?.addEventListener('click', () => document.getElementById('editPopupDialog').close());
		</script>
		<div class="footer"><p>&copy; 2026 Drowsy Vocals | All rights reserved.</p></div>
	</body>
</html>
