<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title><%= user.displayName || user.discordUser || 'Account' %> - Drowsy Vocals</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="account-page">
                <!-- Hero Profile Card -->
                <div class="account-hero-card">
                    <div class="account-hero-identity">
                        <div class="account-hero-avatar-wrap">
                            <%- include('../partials/avatar', {
                                avatarUrl: user.avatarUrl,
                                displayName: user.displayName || user.discordUser || user.login.discordId,
                                discordId: user.login.discordId,
                                size: 104,
                                online: true
                            }) %>
                        </div>
                        <div class="account-hero-details">
                            <p class="profile-eyebrow" style="margin: 0; color: #8e897e;">Member Account</p>
                            <h1 class="account-hero-name"><%= user.displayName || user.discordUser || user.login.discordId %></h1>
                            <div class="account-hero-tags">
                                <% if (user.discordUser) { %>
                                <span class="account-badge">
                                    <span class="material-symbols-outlined" style="font-size: 1.1em;">alternate_email</span>
                                    <span><%= user.discordUser %></span>
                                </span>
                                <% } %>

                                <span class="account-badge account-badge-rank">
                                    <span class="material-symbols-outlined">military_tech</span>
                                    <span><%= user.accountType || 'Staff' %></span>
                                </span>

                                <% if (user.isDeveloper) { %>
                                <span class="account-badge account-badge-dev">
                                    <span class="material-symbols-outlined">terminal</span>
                                    <span>Developer</span>
                                </span>
                                <% } %>

                                <% if (user.house) { %>
                                <span class="account-badge" title="Assigned House">
                                    <span class="account-color-dot" style="background-color: <%= (typeof houseColorMap !== 'undefined' && houseColorMap[user.house]) ? houseColorMap[user.house] : '#888' %>;"></span>
                                    <span><%= user.house %></span>
                                </span>
                                <% } %>

                                <% if (user.shift) { %>
                                <span class="account-badge" title="Assigned Shift">
                                    <span class="account-color-dot" style="background-color: <%= (typeof shiftColorMap !== 'undefined' && shiftColorMap[user.shift]) ? shiftColorMap[user.shift] : '#888' %>;"></span>
                                    <span><%= user.shift %></span>
                                </span>
                                <% } %>

                                <span class="account-badge <%= user.activity === 'Active' ? 'account-badge-active' : user.activity === 'LOA' ? 'account-badge-loa' : user.activity === 'Inactive' ? 'account-badge-warning' : '' %>">
                                    <span><%= user.activity || 'Active' %></span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Flash Notification Messages -->
                <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
                <div class="settings-alert is-success" style="margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="background: transparent; color: #10b981;">check_circle</span>
                        <span><%= success_msg %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
                </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
                <div class="settings-alert is-error" style="margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="background: transparent; color: #ef4444;">error</span>
                        <span><%= error_msg %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
                </div>
                <% } %>

                <!-- Quick Stats Ribbon -->
                <div class="account-stats-ribbon">
                    <div class="account-stat-card">
                        <span class="material-symbols-outlined account-stat-icon">how_to_reg</span>
                        <div class="account-stat-info">
                            <span class="account-stat-label">Attendance Rate</span>
                            <span class="account-stat-val" style="color: <%= (attendanceRate !== null && attendanceRate >= 80) ? '#34d399' : (attendanceRate !== null && attendanceRate >= 50) ? '#fbbf24' : '#f3efe6' %>;">
                                <%= attendanceRate === null ? 'No Data' : `${attendanceRate}%` %>
                            </span>
                        </div>
                    </div>

                    <div class="account-stat-card">
                        <span class="material-symbols-outlined account-stat-icon">verified_user</span>
                        <div class="account-stat-info">
                            <span class="account-stat-label">Disciplinary Record</span>
                            <span class="account-stat-val" style="color: <%= (typeof totalStrikes !== 'undefined' && totalStrikes > 0) ? '#f87171' : '#34d399' %>;">
                                <%= (typeof totalStrikes !== 'undefined' && totalStrikes > 0) ? `${totalStrikes} Strike${totalStrikes === 1 ? '' : 's'}` : 'Clean Record' %>
                            </span>
                        </div>
                    </div>

                    <div class="account-stat-card">
                        <span class="material-symbols-outlined account-stat-icon">calendar_month</span>
                        <div class="account-stat-info">
                            <span class="account-stat-label">Days in Grade</span>
                            <span class="account-stat-val"><%= (typeof daysInGrade !== 'undefined' && daysInGrade !== null) ? `${daysInGrade} Days` : 'Recent' %></span>
                        </div>
                    </div>

                    <div class="account-stat-card">
                        <span class="material-symbols-outlined account-stat-icon">stars</span>
                        <div class="account-stat-info">
                            <span class="account-stat-label">House Points</span>
                            <span class="account-stat-val"><%= user.housePoints || 0 %> Pts</span>
                        </div>
                    </div>
                </div>

                <!-- 2-Column Responsive Layout -->
                <div class="account-grid">
                    <!-- Left Column: Details & Performance -->
                    <div class="account-column">
                        <!-- Badges & Milestones Showcase Card -->
                        <div class="account-card" id="badges">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined" style="color: #fbbf24;">military_tech</span>
                                    <span>Badges & Milestones</span>
                                </h3>
                                <span class="account-badge" style="background: #f59e0b22; color: #fbbf24; border-color: #f59e0b44;">
                                    <%= (typeof badges !== 'undefined' ? badges.length : 0) %> Earned
                                </span>
                            </div>

                            <!-- Unlocked Badges Grid -->
                            <div>
                                <span class="account-info-label" style="display: block; margin-bottom: 10px;">Earned Achievements & Commendations</span>
                                <% if (!badges || !badges.length) { %>
                                <div style="background: #1a1917; border: 1px solid #383734; border-radius: 6px; padding: 18px; text-align: center; color: #8e897e; font-size: 0.9em;">
                                    No badges unlocked yet. Attend meetings and participate in community events to earn badges!
                                </div>
                                <% } else { %>
                                <div class="badges-showcase-grid">
                                    <% badges.forEach(function(b) { %>
                                    <div class="badge-showcase-item badge-tier-<%= b.tier || 'common' %>" title="<%= b.description %>">
                                        <div class="badge-showcase-icon"><%= b.icon || '🏅' %></div>
                                        <div class="badge-showcase-content">
                                            <div class="badge-showcase-header">
                                                <strong class="badge-showcase-name"><%= b.name %></strong>
                                                <span class="badge-showcase-cat"><%= b.category %></span>
                                            </div>
                                            <p class="badge-showcase-desc"><%= b.description %></p>
                                            <% if (b.isCustom && b.awardedBy) { %>
                                            <div class="badge-showcase-meta">
                                                <span>Awarded by <strong><%= b.awardedBy %></strong> <%= b.awardedAt ? `· ${(b.awardedAt).slice(0, 10)}` : '' %></span>
                                            </div>
                                            <% } %>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                                <% } %>
                            </div>

                            <!-- Next Milestones Tracker -->
                            <% if (typeof milestoneProgress !== 'undefined' && milestoneProgress.length) { %>
                            <div style="border-top: 1px solid #383734; padding-top: 16px;">
                                <span class="account-info-label" style="display: block; margin-bottom: 12px;">Milestone Progression Tracker</span>
                                <div style="display: flex; flex-direction: column; gap: 12px;">
                                    <% milestoneProgress.forEach(function(m) { %>
                                    <div class="milestone-track-item">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <span class="material-symbols-outlined" style="font-size: 1.15em; color: #60a5fa; background: transparent; padding: 0;"><%= m.icon %></span>
                                                <strong style="color: #f3efe6; font-size: 0.92em;"><%= m.title %></strong>
                                            </div>
                                            <span style="font-size: 0.82em; color: #fbbf24; font-weight: bold;">
                                                <%= m.current %> / <%= m.target %> <%= m.unit %> (<%= m.percent %>%)
                                            </span>
                                        </div>
                                        <div class="milestone-progress-bg">
                                            <div class="milestone-progress-fill" style="width: <%= m.percent %>%; background: <%= m.percent >= 100 ? '#10b981' : '#fbbf24' %>;"></div>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px; font-size: 0.78em; color: #8e897e;">
                                            <span>Next Goal: <strong><%= m.nextName %></strong></span>
                                            <% if (m.isCompleted) { %>
                                            <span style="color: #10b981; font-weight: bold;">🏆 Max Milestone!</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                            <% } %>
                        </div>

                        <!-- Personnel Details Card -->
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">badge</span>
                                    <span>Staff Profile & Assignments</span>
                                </h3>
                                <span class="account-badge"><%= user.accountType || 'Staff' %></span>
                            </div>

                            <div class="account-info-grid">
                                <div class="account-info-item">
                                    <span class="account-info-label">Display Name</span>
                                    <span class="account-info-val"><%= user.displayName || 'Not Provided' %></span>
                                </div>

                                <div class="account-info-item">
                                    <span class="account-info-label">Discord Username</span>
                                    <span class="account-info-val"><%= user.discordUser ? `@${user.discordUser}` : 'Not Provided' %></span>
                                </div>

                                <div class="account-info-item full-width">
                                    <span class="account-info-label">Discord ID</span>
                                    <span class="account-info-val" style="font-family: monospace;">
                                        <span id="accountDiscordId"><%= user.login.discordId %></span>
                                        <button type="button" class="account-copy-id-btn" onclick="copyDiscordId(this)">
                                            <span class="material-symbols-outlined" style="font-size: 1.1em; background: transparent; padding: 0;">content_copy</span>
                                            <span>Copy</span>
                                        </button>
                                    </span>
                                </div>

                                <div class="account-info-item">
                                    <span class="account-info-label">House Team</span>
                                    <span class="account-info-val">
                                        <% if (user.house) { %>
                                        <span class="account-color-dot" style="background-color: <%= (typeof houseColorMap !== 'undefined' && houseColorMap[user.house]) ? houseColorMap[user.house] : '#888' %>;"></span>
                                        <%= user.house %>
                                        <% } else { %>
                                        Not Assigned
                                        <% } %>
                                    </span>
                                </div>

                                <div class="account-info-item">
                                    <span class="account-info-label">Shift Slot</span>
                                    <span class="account-info-val">
                                        <% if (user.shift) { %>
                                        <span class="account-color-dot" style="background-color: <%= (typeof shiftColorMap !== 'undefined' && shiftColorMap[user.shift]) ? shiftColorMap[user.shift] : '#888' %>;"></span>
                                        <%= user.shift %>
                                        <% } else { %>
                                        Not Assigned
                                        <% } %>
                                    </span>
                                </div>

                                <div class="account-info-item">
                                    <span class="account-info-label">Hire Date</span>
                                    <span class="account-info-val"><%= user.hireDate || 'Not Provided' %></span>
                                </div>

                                <div class="account-info-item">
                                    <span class="account-info-label">Last Promotion</span>
                                    <span class="account-info-val"><%= user.lastPromotion || user.hireDate || 'N/A' %></span>
                                </div>
                            </div>

                            <!-- Training & Onboarding Status -->
                            <div>
                                <span class="account-info-label" style="display: block; margin-bottom: 8px;">Training & Certifications</span>
                                <div class="account-checklist">
                                    <div class="account-check-item <%= user.onboardingComplete ? 'is-done' : 'is-pending' %>">
                                        <span class="material-symbols-outlined" style="font-size: 1.2em; background: transparent; color: inherit; padding: 0;">
                                            <%= user.onboardingComplete ? 'check_circle' : 'pending' %>
                                        </span>
                                        <span>Onboarding <%= user.onboardingComplete ? 'Completed' : 'Pending' %></span>
                                    </div>
                                    <div class="account-check-item <%= user.hostTrainingComplete ? 'is-done' : 'is-pending' %>">
                                        <span class="material-symbols-outlined" style="font-size: 1.2em; background: transparent; color: inherit; padding: 0;">
                                            <%= user.hostTrainingComplete ? 'check_circle' : 'pending' %>
                                        </span>
                                        <span>Host Training <%= user.hostTrainingComplete ? 'Completed' : 'Pending' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Attendance & Strikes Card -->
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">analytics</span>
                                    <span>Attendance & Record</span>
                                </h3>
                                <% if (attendanceRate !== null) { %>
                                <span class="account-badge <%= attendanceRate >= 80 ? 'account-badge-active' : attendanceRate >= 50 ? 'account-badge-rank' : 'account-badge-warning' %>">
                                    <%= attendanceRate %>% Meeting Attendance
                                </span>
                                <% } %>
                            </div>

                            <!-- Attendance Section -->
                            <div>
                                <span class="account-info-label" style="display: block; margin-bottom: 10px;">Recent Weekly Meetings (Last 6 Weeks)</span>
                                <% if (!attendanceHistory || !attendanceHistory.length) { %>
                                <div style="background: #1a1917; border: 1px solid #383734; border-radius: 6px; padding: 14px; text-align: center; color: #8e897e; font-size: 0.9em;">
                                    No meeting attendance records logged yet.
                                </div>
                                <% } else { %>
                                <div class="account-attendance-grid">
                                    <% attendanceHistory.forEach(function(record) { %>
                                    <div class="account-attendance-item">
                                        <span class="account-attendance-week"><%= record.week %></span>
                                        <span class="account-attendance-pill <%= record.attended ? 'attended' : 'absent' %>">
                                            <%= record.attended ? 'Attended' : 'Absent' %>
                                        </span>
                                    </div>
                                    <% }); %>
                                </div>
                                <% } %>
                            </div>

                            <!-- Strikes Section -->
                            <div style="border-top: 1px solid #383734; padding-top: 16px;">
                                <span class="account-info-label" style="display: block; margin-bottom: 10px;">Disciplinary Strikes</span>
                                <% if (user.strikes && user.strikes.length) { %>
                                <div class="account-strikes-list">
                                    <% user.strikes.forEach(function(strike) { %>
                                    <div class="account-strike-card">
                                        <div class="account-strike-top">
                                            <span class="account-strike-count">⚠️ <%= strike.count %> Strike<%= strike.count > 1 ? 's' : '' %></span>
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                <% if (strike.appealStatus === 'Pending') { %>
                                                <span class="settings-badge badge-neutral" style="font-size:0.7em;">Appeal Pending</span>
                                                <% } else if (strike.appealStatus === 'Denied') { %>
                                                <span class="settings-badge badge-danger" style="font-size:0.7em;">Appeal Denied</span>
                                                <% } %>
                                                <span class="account-strike-date"><%= (strike.date || '').slice(0, 10) %></span>
                                            </div>
                                        </div>
                                        <p class="account-strike-reason"><%= strike.reason %></p>

                                        <% if (!strike.appealStatus) { %>
                                        <details class="settings-accordion" style="margin-top:8px;padding:8px 12px;">
                                            <summary style="font-size:0.85em;color:#60a5fa;">
                                                <span class="material-symbols-outlined" style="font-size:1.1em;">gavel</span>
                                                <span>Appeal This Strike</span>
                                            </summary>
                                            <form action="/account/appeal-strike" method="POST" style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
                                                <input type="hidden" name="strikeId" value="<%= strike.id %>">
                                                <textarea name="reason" class="settings-textarea" rows="2" placeholder="Explain circumstances or reasons why this strike should be reconsidered..." minlength="10" required style="font-size:0.85em;min-height:60px;"></textarea>
                                                <button type="submit" class="settings-btn settings-btn-primary settings-btn-sm" style="align-self:flex-start;">
                                                    <span class="material-symbols-outlined">send</span>
                                                    <span>Submit Appeal</span>
                                                </button>
                                            </form>
                                        </details>
                                        <% } %>
                                    </div>
                                    <% }); %>
                                </div>
                                <% } else { %>
                                <div class="account-clean-banner">
                                    <span class="material-symbols-outlined">verified</span>
                                    <div>
                                        <div class="account-clean-title">Clean Disciplinary Record</div>
                                        <div class="account-clean-sub">You have no active strikes recorded on your profile.</div>
                                    </div>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Avatar & Security -->
                    <div class="account-column">
                        <!-- Profile Photo Card -->
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">photo_camera</span>
                                    <span>Profile Picture</span>
                                </h3>
                            </div>

                            <form class="account-form" action="/account/upload-avatar" method="POST" enctype="multipart/form-data">
                                <div style="display: flex; align-items: center; justify-content: center; padding: 10px 0;">
                                    <%- include('../partials/avatar', {
                                        avatarUrl: user.avatarUrl,
                                        displayName: user.displayName || user.discordUser || user.login.discordId,
                                        discordId: user.login.discordId,
                                        size: 90
                                    }) %>
                                </div>

                                <div class="account-file-box" onclick="document.getElementById('avatarFileInput').click()">
                                    <input type="file" id="avatarFileInput" name="avatar" accept="image/png, image/jpeg, image/webp" required onchange="updateFileLabel(this)">
                                    <label class="account-file-box-label" for="avatarFileInput">
                                        <span class="material-symbols-outlined">cloud_upload</span>
                                        <span class="account-file-box-text" id="avatarFileText">Choose an image or drop file here</span>
                                        <span class="account-file-box-hint">Supported formats: PNG, JPEG, WEBP (Max 2MB)</span>
                                    </label>
                                </div>

                                <button type="submit" class="account-btn account-btn-primary">
                                    <span class="material-symbols-outlined">upload</span>
                                    <span>Upload New Avatar</span>
                                </button>
                            </form>
                        </div>

                        <!-- Password Update Card -->
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">lock_reset</span>
                                    <span>Security & Password</span>
                                </h3>
                            </div>

                            <form class="account-form" action="/change-password" method="POST">
                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="currentPassword">Current Password</label>
                                    <input type="password" id="currentPassword" name="currentPassword" class="settings-input" placeholder="••••••••" required autocomplete="current-password">
                                </div>

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="newPassword">New Password</label>
                                    <input type="password" id="newPassword" name="newPassword" class="settings-input" placeholder="At least 8 characters" minlength="8" required autocomplete="new-password">
                                </div>

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="confirmPassword">Confirm New Password</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword" class="settings-input" placeholder="Repeat new password" minlength="8" required autocomplete="new-password">
                                </div>

                                <button type="submit" class="account-btn account-btn-primary">
                                    <span class="material-symbols-outlined">key</span>
                                    <span>Update Password</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>

        <script>
            function copyDiscordId(buttonEl) {
                const idEl = document.getElementById('accountDiscordId');
                if (!idEl) return;
                navigator.clipboard.writeText(idEl.innerText.trim()).then(() => {
                    const originalHtml = buttonEl.innerHTML;
                    buttonEl.innerHTML = '<span class="material-symbols-outlined" style="font-size:1.1em;background:transparent;padding:0;color:#34d399;">check</span><span style="color:#34d399;">Copied!</span>';
                    setTimeout(() => {
                        buttonEl.innerHTML = originalHtml;
                    }, 2000);
                });
            }

            function updateFileLabel(input) {
                const label = document.getElementById('avatarFileText');
                if (input.files && input.files.length > 0) {
                    label.textContent = input.files[0].name;
                    label.style.color = '#34d399';
                }
            }
        </script>
    </body>
</html>
