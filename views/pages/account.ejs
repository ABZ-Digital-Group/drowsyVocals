<!DOCTYPE html>

<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Account</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="profile-page">
                <div class="profile-heading">
                    <p class="profile-eyebrow">Account profile</p>
                    <%- include('../partials/avatar', {
                        avatarUrl: user.avatarUrl,
                        displayName: user.displayName || user.discordUser || user.login.discordId,
                        size: 96
                    }) %>
                    <h1><%= user.displayName || user.discordUser || user.login.discordId %></h1>
                    <p class="profile-subtitle">Your Drowsy Vocals member details.</p>
                </div>
                <div class="profile-details">
                    <div class="profile-detail">
                        <span>Display Name</span>
                        <strong><%= user.displayName || 'Not provided' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Discord User</span>
                        <strong><%= user.discordUser || 'Not provided' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Discord ID</span>
                        <strong><%= user.login.discordId %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Account Type</span>
                        <strong><%= user.accountType || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>House</span>
                        <strong><%= user.house || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Shift</span>
                        <strong><%= user.shift || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Hire Date</span>
                        <strong><%= user.hireDate || 'Not provided' %></strong>
                    </div>
                    <div class="profile-detail">
                        <span>Activity</span>
                        <strong><%= user.activity || 'Not assigned' %></strong>
                    </div>
                    <div class="profile-detail-full">
                        <span>Strikes</span>
                        <% if (user.strikes && user.strikes.length) { %>
                        <strong><%= user.strikes.reduce((sum, strike) => sum + (Number(strike.count) || 0), 0) %> total strike(s)</strong>
                        <ul class="strikes-list">
                            <% user.strikes.forEach(function(strike) { %>
                            <li>
                                <strong><%= strike.count %> strike(s)</strong> - <%= strike.reason %>
                                <br><small><%= (strike.date || '').slice(0, 10) %></small>
                            </li>
                            <% }); %>
                        </ul>
                        <% } else { %>
                        <strong>No strikes on record</strong>
                        <% } %>
                    </div>
                    <div class="profile-detail-full attendance-history">
                        <span>Attendance History <%= attendanceRate === null ? '' : `(${attendanceRate}% attended)` %></span>
                        <% if (!attendanceHistory.length) { %>
                        <strong>No meetings have been recorded for you yet.</strong>
                        <% } else { %>
                        <ul>
                            <% attendanceHistory.forEach(function(record) { %>
                            <li><strong><%= record.week %></strong><span class="attendance-status <%= record.attended ? 'attended' : 'absent' %>"><%= record.attended ? 'Attended' : 'Absent' %></span></li>
                            <% }); %>
                        </ul>
                        <% } %>
                    </div>
                    <div class="profile-detail-full">
                        <span>Profile Picture</span>
                        <form class="login-form-actions" action="/account/upload-avatar" method="POST" enctype="multipart/form-data">
                            <label for="avatar">Upload New Photo (PNG, JPEG, or WEBP, max 2MB):</label>
                            <input type="file" id="avatar" name="avatar" accept="image/png, image/jpeg, image/webp" required>

                            <button type="submit">Upload Photo</button>
                        </form>
                    </div>
                    <div class="profile-detail-full">
                        <span>Change Password</span>
                        <form class="login-form-actions" action="/change-password" method="POST">
                            <label for="currentPassword">Current Password:</label>
                            <input type="password" id="currentPassword" name="currentPassword" required>

                            <label for="newPassword">New Password:</label>
                            <input type="password" id="newPassword" name="newPassword" minlength="8" required>

                            <label for="confirmPassword">Confirm New Password:</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" minlength="8" required>

                            <button type="submit">Update Password</button>
                        </form>
                    </div>
                </div>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
    </body>
</html>
