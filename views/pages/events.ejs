<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Events Schedule - Drowsy Vocals</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="settings-page">
                <!-- Header -->
                <div class="settings-header">
                    <div class="settings-header-top">
                        <div>
                            <p class="profile-eyebrow">Community & Programming</p>
                            <h1 style="margin: 0; font-size: 2.4em; color: var(--night-indigo);">Events Schedule & Calendar</h1>
                            <p class="profile-subtitle">Upcoming karaoke sessions, stage events, staff meetings, and community activities.</p>
                        </div>
                    </div>

                    <!-- Quick Stats -->
                    <div class="settings-stats-bar">
                        <div class="settings-stat-item">
                            <span class="material-symbols-outlined settings-stat-icon" style="color: var(--misty-blue);">event</span>
                            <div class="settings-stat-info">
                                <span class="settings-stat-label">Upcoming Events</span>
                                <span class="settings-stat-val" style="color: var(--misty-blue);"><%= upcomingEvents.length %> Scheduled</span>
                            </div>
                        </div>

                        <div class="settings-stat-item">
                            <span class="material-symbols-outlined settings-stat-icon" style="color: #34d399;">mic</span>
                            <div class="settings-stat-info">
                                <span class="settings-stat-label">Karaoke Nights</span>
                                <span class="settings-stat-val"><%= upcomingEvents.filter(e => e.category === 'Karaoke').length %> Planned</span>
                            </div>
                        </div>

                        <div class="settings-stat-item">
                            <span class="material-symbols-outlined settings-stat-icon" style="color: var(--dreamy-periwinkle);">groups</span>
                            <div class="settings-stat-info">
                                <span class="settings-stat-label">Team Meetings</span>
                                <span class="settings-stat-val"><%= upcomingEvents.filter(e => e.category === 'Staff Meeting').length %> Planned</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Flash Message Alerts -->
                <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
                <div class="settings-alert is-success" style="margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="background: transparent; color: #10b981;">check_circle</span>
                        <span><%= success_msg %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
                </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
                <div class="settings-alert is-error" style="margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="background: transparent; color: #ef4444;">error</span>
                        <span><%= error_msg %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;font-weight:bold;">&times;</button>
                </div>
                <% } %>

                <div class="account-grid">
                    <!-- Left Column: Upcoming Events List -->
                    <div class="account-column">
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">event_available</span>
                                    <span>Upcoming Community Events</span>
                                </h3>
                                <span class="account-badge"><%= upcomingEvents.length %> Upcoming</span>
                            </div>

                            <div class="events-tz-bar" style="background: var(--night-indigo); border: 1px solid var(--dusty-blue-purple); border-radius: 6px; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 0.85em; color: var(--dusty-blue-purple);">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="material-symbols-outlined" style="font-size: 1.2em; color: var(--misty-blue); background: transparent; padding: 0;">schedule</span>
                                    <span>All event times shown in Eastern Time: <strong id="eventsUserTimezone" style="color: var(--cloud-white);">America/New_York</strong></span>
                                </div>
                                <span id="eventsUserOffset" style="font-size: 0.85em; color: var(--moonlight-yellow); font-weight: bold;"></span>
                            </div>

                            <% if (!upcomingEvents || upcomingEvents.length === 0) { %>
                            <div style="background: var(--night-indigo); border: 1px solid var(--dusty-blue-purple); border-radius: 6px; padding: 36px 16px; text-align: center; color: var(--dusty-blue-purple);">
                                <span class="material-symbols-outlined" style="font-size: 2.8em; color: var(--dusty-blue-purple);" aria-hidden="true">event_busy</span>
                                <h4 style="margin: 8px 0 4px; color: var(--cloud-white);">No Upcoming Events Scheduled</h4>
                                <p style="margin: 0; font-size: 0.85em;">Check back soon or schedule a new community event using the manager form.</p>
                            </div>
                            <% } else { %>
                            <div style="display: flex; flex-direction: column; gap: 14px;">
                                <% upcomingEvents.forEach(function(event) { %>
                                <div style="background: var(--night-indigo); border: 1px solid var(--dusty-blue-purple); border-left: 4px solid <%= event.category === 'Karaoke' ? 'var(--misty-blue)' : event.category === 'Staff Meeting' ? 'var(--moonlight-yellow)' : 'var(--dreamy-periwinkle)' %>; border-radius: 6px; padding: 18px; display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px;">
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                <span class="settings-badge" style="background:var(--night-indigo);border:1px solid #444;font-size:0.75em;"><%= event.category || 'Event' %></span>
                                                <h4 style="margin: 0; font-size: 1.2em; color: var(--cloud-white);"><%= event.title %></h4>
                                            </div>
                                            <span style="font-size: 0.8em; color: var(--dusty-blue-purple); margin-top: 4px; display: block;">
                                                📍 <%= event.location || 'Discord Stage' %>
                                            </span>
                                        </div>

                                        <div class="event-time-display" data-event-start="<%= event.scheduledStartTime %>" data-event-end="<%= event.scheduledEndTime || '' %>" style="text-align: right;">
                                            <span class="event-time-primary" style="font-size: 1em; font-weight: bold; color: var(--moonlight-yellow); display: block;">
                                                <%= new Date(event.scheduledStartTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                                            </span>
                                            <small class="event-time-secondary" style="color: var(--dusty-blue-purple); display: block;">
                                                <% if (event.scheduledEndTime) { %>until <%= new Date(event.scheduledEndTime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %><% } %>
                                            </small>
                                            <span class="event-time-relative" style="display: inline-block; font-size: 0.72em; padding: 2px 6px; border-radius: 4px; margin-top: 4px; font-weight: bold;"></span>
                                        </div>
                                    </div>

                                    <!-- Event Staff / Leadership Line -->
                                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 2px;">
                                        <%
                                            const hostUser = (event.host && userMap && userMap[event.host]) ? userMap[event.host] : null;
                                            const coHostUser = (event.coHost && userMap && userMap[event.coHost]) ? userMap[event.coHost] : null;
                                            const adminUser = (event.admin && userMap && userMap[event.admin]) ? userMap[event.admin] : null;
                                            const creatorUser = (event.createdBy && userMap && userMap[event.createdBy]) ? userMap[event.createdBy] : null;
                                        %>

                                        <% if (hostUser || event.host) { %>
                                        <span class="settings-badge" style="background:var(--night-indigo); border:1px solid var(--dusty-blue-purple); font-size:0.75em; display: inline-flex; align-items: center; gap: 4px; color: var(--cloud-white);">
                                            <span class="material-symbols-outlined" style="font-size: 1.1em; color: var(--misty-blue); background: transparent; padding: 0;">mic</span>
                                            <strong>Host:</strong> <%= hostUser ? (hostUser.displayName || hostUser.discordUser) : event.host %>
                                        </span>
                                        <% } else { %>
                                        <span class="settings-badge" style="background:var(--night-indigo); border:1px solid var(--dusty-blue-purple); font-size:0.75em; display: inline-flex; align-items: center; gap: 4px; color: var(--dusty-blue-purple);">
                                            <span class="material-symbols-outlined" style="font-size: 1.1em; color: var(--dusty-blue-purple); background: transparent; padding: 0;">person</span>
                                            <strong>Organizer:</strong> <%= creatorUser ? (creatorUser.displayName || creatorUser.discordUser) : event.createdBy %>
                                        </span>
                                        <% } %>

                                        <% if (coHostUser || event.coHost) { %>
                                        <span class="settings-badge" style="background:var(--night-indigo); border:1px solid var(--dusty-blue-purple); font-size:0.75em; display: inline-flex; align-items: center; gap: 4px; color: var(--cloud-white);">
                                            <span class="material-symbols-outlined" style="font-size: 1.1em; color: #34d399; background: transparent; padding: 0;">group</span>
                                            <strong>Co-Host:</strong> <%= coHostUser ? (coHostUser.displayName || coHostUser.discordUser) : event.coHost %>
                                        </span>
                                        <% } %>

                                        <% if (adminUser || event.admin) { %>
                                        <span class="settings-badge" style="background:var(--night-indigo); border:1px solid var(--dusty-blue-purple); font-size:0.75em; display: inline-flex; align-items: center; gap: 4px; color: var(--cloud-white);">
                                            <span class="material-symbols-outlined" style="font-size: 1.1em; color: var(--moonlight-yellow); background: transparent; padding: 0;">shield_person</span>
                                            <strong>Admin:</strong> <%= adminUser ? (adminUser.displayName || adminUser.discordUser) : event.admin %>
                                        </span>
                                        <% } %>
                                    </div>

                                    <% if (event.description) { %>
                                    <p style="margin: 0; color: var(--cloud-lilac); font-size: 0.9em; line-height: 1.5; white-space: pre-wrap;"><%= event.description %></p>
                                    <% } %>

                                    <% if (isManager) { %>
                                    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; border-top: 1px solid #282724; padding-top: 10px; margin-top: 4px;">
                                        <button type="button" class="settings-btn settings-btn-secondary settings-btn-sm editEventBtn"
                                            data-event-id="<%= event.id || event._id %>"
                                            data-event-title="<%= event.title %>"
                                            data-event-category="<%= event.category || 'Karaoke' %>"
                                            data-event-location="<%= event.location || 'Discord Stage' %>"
                                            data-event-host="<%= event.host || '' %>"
                                            data-event-co-host="<%= event.coHost || '' %>"
                                            data-event-admin="<%= event.admin || '' %>"
                                            data-event-start-iso="<%= event.scheduledStartTime %>"
                                            data-event-end-iso="<%= event.scheduledEndTime || '' %>"
                                            data-event-desc="<%= event.description || '' %>">
                                            <span class="material-symbols-outlined">edit</span>
                                            <span>Edit</span>
                                        </button>
                                        <form action="/events/<%= event.id || event._id %>/delete" method="POST" onsubmit="return confirm('Remove event <%= event.title %>?');" style="margin: 0;">
                                            <button type="submit" class="settings-btn settings-btn-danger settings-btn-sm">
                                                <span class="material-symbols-outlined">delete</span>
                                                <span>Delete Event</span>
                                            </button>
                                        </form>
                                    </div>
                                    <% } %>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Pop-up Events -->
                        <div class="account-card" style="margin-top: 20px;">
                            <div class="account-card-header">
                                <h3 class="account-card-title"><span class="material-symbols-outlined">bolt</span><span>Pop-up Events</span></h3>
                                <span class="account-badge"><%= upcomingPopUps.length %> Upcoming</span>
                            </div>
                            <% if (!upcomingPopUps.length) { %>
                            <div style="background: var(--night-indigo); border: 1px solid var(--dusty-blue-purple); border-radius: 6px; padding: 24px 16px; text-align: center; color: var(--dusty-blue-purple);">
                                <span class="material-symbols-outlined" style="font-size: 2.2em; color: var(--dusty-blue-purple);">event_busy</span>
                                <h4 style="margin: 8px 0 4px; color: var(--cloud-white);">No Pop-up Events Scheduled</h4>
                                <p style="margin: 0; font-size: 0.85em;">Special events will appear here once scheduled.</p>
                            </div>
                            <% } else { %>
                            <div style="display: flex; flex-direction: column; gap: 14px;">
                                <% upcomingPopUps.forEach(function(event) { %>
                                <article style="background: var(--night-indigo); border: 1px solid var(--dusty-blue-purple); border-left: 4px solid var(--moonlight-yellow); border-radius: 6px; padding: 18px;">
                                    <div style="display: flex; justify-content: space-between; gap: 12px; align-items: flex-start;">
                                        <div><span class="settings-badge" style="background:var(--night-indigo);border:1px solid #444;font-size:0.75em;">Pop-up</span><h4 style="margin: 8px 0 0; color: var(--cloud-white); font-size: 1.2em;"><%= event.title %></h4><span style="display: block; margin-top: 5px; color: var(--dusty-blue-purple);">📍 <%= event.location || 'Discord' %></span><% if (event.host) { const hostUser = (users || []).find((user) => user.login?.discordId === event.host); %><span style="display: block; margin-top: 5px; color: var(--cloud-lilac);">Host: <%= hostUser ? (hostUser.displayName || hostUser.discordUser) : event.host %></span><% } %></div>
                                        <time style="color: var(--moonlight-yellow); font-weight: bold; text-align: right; white-space: nowrap;"><%= new Date(event.scheduledStartTime).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></time>
                                    </div>
                                    <% if (event.description) { %><p style="margin: 12px 0 0; color: var(--cloud-lilac); line-height: 1.5; white-space: pre-wrap;"><%= event.description %></p><% } %>
                                    <% if (isManager) { %><div style="display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid #282724; padding-top: 10px; margin-top: 12px;"><button type="button" class="settings-btn settings-btn-secondary settings-btn-sm editPopupBtn" data-id="<%= event.id || event._id %>" data-title="<%= event.title %>" data-location="<%= event.location || 'Discord' %>" data-host="<%= event.host || '' %>" data-description="<%= event.description || '' %>" data-start="<%= event.scheduledStartTime %>" data-end="<%= event.scheduledEndTime || '' %>"><span class="material-symbols-outlined">edit</span>Edit</button><form action="/pop-up/<%= event.id || event._id %>/delete" method="POST" onsubmit="return confirm('Remove this pop-up event?')"><button type="submit" class="settings-btn settings-btn-danger settings-btn-sm"><span class="material-symbols-outlined">delete</span>Delete</button></form></div><% } %>
                                </article>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Past Events Archive -->
                        <% if (pastEvents && pastEvents.length > 0) { %>
                        <details class="settings-accordion">
                            <summary>
                                <span class="material-symbols-outlined">history</span>
                                <span>Past Events Archive (<%= pastEvents.length %> Events)</span>
                            </summary>
                            <div class="settings-accordion-content">
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    <% pastEvents.slice(0, 10).forEach(function(event) { %>
                                    <div class="event-history-row">
                                    <button type="button" class="event-history-item"
                                        data-event-id="<%= event.id || event._id %>"
                                        data-event-title="<%= event.title %>"
                                        data-event-category="<%= event.category || 'Event' %>"
                                        data-event-location="<%= event.location || 'Discord Stage' %>"
                                        data-event-start="<%= event.scheduledStartTime || '' %>"
                                        data-event-end="<%= event.scheduledEndTime || '' %>"
                                        data-event-host="<%= event.host && userMap[event.host] ? (userMap[event.host].displayName || userMap[event.host].discordUser) : (event.host || 'Not assigned') %>"
                                        data-event-co-host="<%= event.coHost && userMap[event.coHost] ? (userMap[event.coHost].displayName || userMap[event.coHost].discordUser) : (event.coHost || 'Not assigned') %>"
                                        data-event-admin="<%= event.admin && userMap[event.admin] ? (userMap[event.admin].displayName || userMap[event.admin].discordUser) : (event.admin || 'Not assigned') %>"
                                        data-event-description="<%= event.description || 'No description provided.' %>">
                                        <div>
                                            <strong style="color: var(--cloud-lilac);"><%= event.title %></strong>
                                            <span class="past-event-time" data-event-start="<%= event.scheduledStartTime %>" style="font-size: 0.75em; color: var(--dusty-blue-purple); display: block;">
                                                <%= (event.scheduledStartTime || '').slice(0, 10) %> · <%= event.category %>
                                            </span>
                                        </div>
                                        <span class="settings-badge badge-neutral" style="font-size: 0.75em;">Concluded</span>
                                    </button>
                                    <% if (isManager) { %>
                                    <button type="button" class="settings-btn settings-btn-secondary settings-btn-sm editEventBtn"
                                        data-event-id="<%= event.id || event._id %>"
                                        data-event-title="<%= event.title %>"
                                        data-event-category="<%= event.category || 'Karaoke' %>"
                                        data-event-location="<%= event.location || 'Discord Stage' %>"
                                        data-event-host="<%= event.host || '' %>"
                                        data-event-co-host="<%= event.coHost || '' %>"
                                        data-event-admin="<%= event.admin || '' %>"
                                        data-event-start-iso="<%= event.scheduledStartTime || '' %>"
                                        data-event-end-iso="<%= event.scheduledEndTime || '' %>"
                                        data-event-desc="<%= event.description || '' %>">
                                        Edit
                                    </button>
                                    <% } %>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                        </details>
                        <% } %>
                    </div>

                    <!-- Right Column: Schedule New Event (Manager Only) -->
                    <div class="account-column">
                        <% if (isManager) { %>
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">add_circle</span>
                                    <span>Schedule New Event</span>
                                </h3>
                                <span class="account-badge">Manager Tool</span>
                            </div>

                            <form class="account-form" id="createEventForm" action="/events/create" method="POST">
                                <input type="hidden" id="eventStartIso" name="startIso">
                                <input type="hidden" id="eventEndIso" name="endIso">
                                <input type="hidden" id="eventClientTimezone" name="clientTimezone">

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="eventTitle">Event Title</label>
                                    <input type="text" id="eventTitle" name="title" class="settings-input" placeholder="e.g. Friday Night Karaoke Special" required>
                                </div>

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="eventCategory">Category</label>
                                    <select id="eventCategory" name="category" class="settings-input" required>
                                        <option value="Karaoke">🎤 Karaoke / Singing</option>
                                        <option value="Staff Meeting">👥 Weekly Staff Meeting</option>
                                        <option value="Game Night">🎮 Community Game Night</option>
                                        <option value="Training">🎓 Staff Workshop & Training</option>
                                        <option value="Special Event">✨ Special Celebration / Gala</option>
                                    </select>
                                </div>

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="eventLocation">Voice Channel / Location</label>
                                    <input type="text" id="eventLocation" name="location" class="settings-input" value="Discord Stage" placeholder="e.g. Discord Stage, Main Lounge" required>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventStartDate">Start Date</label>
                                        <input type="date" id="eventStartDate" name="startDate" class="settings-input" required>
                                    </div>
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventStartTime">Start Time</label>
                                        <input type="time" id="eventStartTime" name="startTime" class="settings-input" required>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventEndDate">End Date (Optional)</label>
                                        <input type="date" id="eventEndDate" name="endDate" class="settings-input">
                                    </div>
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventEndTime">End Time (Optional)</label>
                                        <input type="time" id="eventEndTime" name="endTime" class="settings-input">
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventHost">🎤 Host</label>
                                        <select id="eventHost" name="host" class="settings-input">
                                            <option value="">-- Select Host (Optional) --</option>
                                            <% (users || []).forEach(function(u) { %>
                                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventCoHost">👥 Co-Host</label>
                                        <select id="eventCoHost" name="coHost" class="settings-input">
                                            <option value="">-- None / Optional --</option>
                                            <% (users || []).forEach(function(u) { %>
                                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div class="settings-form-group" style="margin-bottom: 0;">
                                        <label for="eventAdmin">🛡️ Admin on Duty</label>
                                        <select id="eventAdmin" name="admin" class="settings-input">
                                            <option value="">-- None / Optional --</option>
                                            <% (users || []).forEach(function(u) { %>
                                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                                            <% }); %>
                                        </select>
                                    </div>
                                </div>

                                <p style="margin: 4px 0 0; font-size: 0.8em; color: var(--dusty-blue-purple); display: flex; align-items: center; gap: 6px;">
                                    <span class="material-symbols-outlined" style="font-size: 1.1em; color: var(--misty-blue); background: transparent; padding: 0;">schedule</span>
                                    <span>Times you select above are in Eastern Time (<strong class="form-user-tz" style="color: var(--cloud-lilac);">America/New_York</strong>) and automatically converted for viewers worldwide.</span>
                                </p>

                                <div class="settings-form-group" style="margin-bottom: 0;">
                                    <label for="eventDesc">Description / Rules</label>
                                    <textarea id="eventDesc" name="description" class="settings-textarea" rows="3" placeholder="Explain the theme, guidelines, and what users can expect..."></textarea>
                                </div>

                                <button type="submit" class="account-btn account-btn-primary">
                                    <span class="material-symbols-outlined">event_upcoming</span>
                                    <span>Publish & Announce Event</span>
                                </button>
                            </form>
                        </div>
                        <div class="account-card" style="margin-top: 20px;">
                            <div class="account-card-header"><h3 class="account-card-title"><span class="material-symbols-outlined">bolt</span><span>Schedule Pop-up Event</span></h3><span class="account-badge">Manager Tool</span></div>
                            <form class="account-form popup-event-form" action="/pop-up/create" method="POST">
                                <input type="hidden" name="startIso"><input type="hidden" name="endIso">
                                <label for="popupTitle">Event Title</label><input id="popupTitle" name="title" class="settings-input" placeholder="e.g. Surprise Karaoke Night" required>
                                <label for="popupLocation">Location</label><input id="popupLocation" name="location" class="settings-input" value="Discord" required>
                                <label for="popupHost">Staff Member Running Event</label><select id="popupHost" name="host" class="settings-input"><option value="">-- Select Staff Member --</option><% (users || []).forEach(function(user) { %><option value="<%= user.login.discordId %>"><%= user.displayName || user.discordUser %> (<%= user.accountType %>)</option><% }); %></select>
                                <label for="popupStart">Start</label><input id="popupStart" class="settings-input popup-start" type="datetime-local" required>
                                <label for="popupEnd">End (Optional)</label><input id="popupEnd" class="settings-input popup-end" type="datetime-local">
                                <label for="popupDescription">Description / Rules</label><textarea id="popupDescription" name="description" class="settings-textarea" rows="4" placeholder="Share the details for this special event..."></textarea>
                                <button type="submit" class="account-btn account-btn-primary"><span class="material-symbols-outlined">bolt</span>Schedule Pop-up</button>
                            </form>
                        </div>
                        <% } else { %>
                        <div class="account-card">
                            <div class="account-card-header">
                                <h3 class="account-card-title">
                                    <span class="material-symbols-outlined">info</span>
                                    <span>Event Participation Guide</span>
                                </h3>
                            </div>
                            <p style="margin: 0; color: var(--cloud-lilac); font-size: 0.9em; line-height: 1.6;">
                                Join the specified voice/stage channel on Discord when the event starts. Stage events allow you to join the queue with <code>!join</code> or using the button on the control room embed.
                            </p>
                        </div>
                        <% } %>
                    </div>
                </div>
            </section>
        </main>
        <dialog id="eventHistoryDetails" class="dialog-wide">
            <div class="event-history-details-header">
                <div>
                    <span id="eventHistoryCategory" class="settings-badge badge-neutral"></span>
                    <h3 id="eventHistoryTitle"></h3>
                </div>
                <button type="button" id="closeEventHistoryDetails" aria-label="Close event details">&times;</button>
            </div>
            <div class="event-history-details-grid">
                <div><span>When</span><strong id="eventHistoryWhen"></strong></div>
                <div><span>Location</span><strong id="eventHistoryLocation"></strong></div>
                <div><span>Host</span><strong id="eventHistoryHost"></strong></div>
                <div><span>Co-host</span><strong id="eventHistoryCoHost"></strong></div>
                <div><span>Admin on duty</span><strong id="eventHistoryAdmin"></strong></div>
            </div>
            <div class="event-history-description">
                <span>Description</span>
                <p id="eventHistoryDescription"></p>
            </div>
            <% if (isManager) { %>
            <div class="event-history-details-actions">
                <button type="button" id="editEventFromHistory" class="settings-btn settings-btn-primary">Edit Event</button>
            </div>
            <% } %>
        </dialog>
        <% if (pastPopUps && pastPopUps.length > 0) { %>
        <section class="settings-page" style="padding-top: 0;">
            <details class="settings-accordion">
                <summary><span class="material-symbols-outlined">history</span><span>Past Pop-up Events (<%= pastPopUps.length %>)</span></summary>
                <div class="settings-accordion-content"><% pastPopUps.forEach(function(event) { %><div style="padding: 10px 0; border-bottom: 1px solid #333;"><strong style="color: var(--cloud-lilac);"><%= event.title %></strong><span style="display: block; color: var(--dusty-blue-purple); font-size: .8em;"><%= new Date(event.scheduledStartTime).toLocaleString() %> · <%= event.location || 'Discord' %></span></div><% }); %></div>
            </details>
        </section>
        <% } %>
        <% if (isManager) { %>
        <dialog id="editPopupDialog" class="dialog-wide">
            <form class="account-form" id="editPopupForm" method="POST">
                <h3>Edit Pop-up Event</h3>
                <input type="hidden" name="startIso"><input type="hidden" name="endIso">
                <label>Event Title</label><input name="title" class="settings-input" required>
                <label>Location</label><input name="location" class="settings-input" required>
                <label>Staff Member Running Event</label><select name="host" class="settings-input"><option value="">-- Select Staff Member --</option><% (users || []).forEach(function(user) { %><option value="<%= user.login.discordId %>"><%= user.displayName || user.discordUser %> (<%= user.accountType %>)</option><% }); %></select>
                <label>Start</label><input class="settings-input popup-start" type="datetime-local" required>
                <label>End (Optional)</label><input class="settings-input popup-end" type="datetime-local">
                <label>Description / Rules</label><textarea name="description" class="settings-textarea" rows="4"></textarea>
                <div class="dialog-buttons"><button type="submit">Save Changes</button><button type="button" id="closeEditPopup">Cancel</button></div>
            </form>
        </dialog>
        <script>
            document.querySelectorAll('.popup-event-form').forEach((form) => form.addEventListener('submit', () => {
                form.querySelector('[name="startIso"]').value = new Date(form.querySelector('.popup-start').value).toISOString();
                const end = form.querySelector('.popup-end').value;
                form.querySelector('[name="endIso"]').value = end ? new Date(end).toISOString() : '';
            }));
            document.querySelectorAll('.editPopupBtn').forEach((button) => button.addEventListener('click', () => {
                const dialog = document.getElementById('editPopupDialog');
                const form = document.getElementById('editPopupForm');
                form.action = `/pop-up/${button.dataset.id}/update`;
                form.title.value = button.dataset.title;
                form.location.value = button.dataset.location;
                form.host.value = button.dataset.host;
                form.description.value = button.dataset.description;
                form.querySelector('.popup-start').value = new Date(button.dataset.start).toISOString().slice(0, 16);
                form.querySelector('.popup-end').value = button.dataset.end ? new Date(button.dataset.end).toISOString().slice(0, 16) : '';
                dialog.showModal();
            }));
            document.getElementById('closeEditPopup')?.addEventListener('click', () => document.getElementById('editPopupDialog').close());
        </script>
        <% } %>
        <% if (isManager) { %>
        <dialog id="editEventPopup" class="dialog-wide">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--night-indigo); padding-bottom: 12px; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 1.25em; display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="background: transparent; color: var(--night-indigo);">edit_calendar</span>
                    <span>Edit Scheduled Event</span>
                </h3>
                <button type="button" id="closeEditEventCross" style="background:none;border:none;color:inherit;cursor:pointer;font-size:1.4em;font-weight:bold;line-height:1;">&times;</button>
            </div>

            <form id="editEventForm" action="" method="POST">
                <input type="hidden" id="editEventStartIso" name="startIso">
                <input type="hidden" id="editEventEndIso" name="endIso">
                <input type="hidden" id="editEventClientTimezone" name="clientTimezone">

                <label for="editEventTitle">Event Title</label>
                <input type="text" id="editEventTitle" name="title" required>

                <label for="editEventCategory">Category</label>
                <select id="editEventCategory" name="category" required>
                    <option value="Karaoke">🎤 Karaoke / Singing</option>
                    <option value="Staff Meeting">👥 Weekly Staff Meeting</option>
                    <option value="Game Night">🎮 Community Game Night</option>
                    <option value="Training">🎓 Staff Workshop & Training</option>
                    <option value="Special Event">✨ Special Celebration / Gala</option>
                </select>

                <label for="editEventLocation">Voice Channel / Location</label>
                <input type="text" id="editEventLocation" name="location" required>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                        <label for="editEventStartDate">Start Date</label>
                        <input type="date" id="editEventStartDate" name="startDate" required>
                    </div>
                    <div>
                        <label for="editEventStartTime">Start Time</label>
                        <input type="time" id="editEventStartTime" name="startTime" required>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                        <label for="editEventEndDate">End Date (Optional)</label>
                        <input type="date" id="editEventEndDate" name="endDate">
                    </div>
                    <div>
                        <label for="editEventEndTime">End Time (Optional)</label>
                        <input type="time" id="editEventEndTime" name="endTime">
                    </div>
                </div>

                <p style="margin: 6px 0 0; font-size: 0.8em; color: var(--night-indigo); display: flex; align-items: center; gap: 6px;">
                    <span class="material-symbols-outlined" style="font-size: 1.1em; color: var(--night-indigo); background: transparent; padding: 0;">schedule</span>
                    <span>Times above use Eastern Time (<strong class="form-user-tz">America/New_York</strong>).</span>
                </p>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px;">
                    <div>
                        <label for="editEventHost">🎤 Host</label>
                        <select id="editEventHost" name="host">
                            <option value="">-- None / Unassigned --</option>
                            <% (users || []).forEach(function(u) { %>
                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label for="editEventCoHost">👥 Co-Host</label>
                        <select id="editEventCoHost" name="coHost">
                            <option value="">-- None / Optional --</option>
                            <% (users || []).forEach(function(u) { %>
                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label for="editEventAdmin">🛡️ Admin on Duty</label>
                        <select id="editEventAdmin" name="admin">
                            <option value="">-- None / Optional --</option>
                            <% (users || []).forEach(function(u) { %>
                            <option value="<%= u.login.discordId %>"><%= u.displayName || u.discordUser %> (<%= u.accountType %>)</option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <label for="editEventDesc">Description / Rules</label>
                <textarea id="editEventDesc" name="description" rows="3"></textarea>

                <div class="dialog-buttons">
                    <button type="submit">Save Changes</button>
                    <button type="button" id="closeEditEventPopup">Cancel</button>
                </div>
            </form>
        </dialog>
        <% } %>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
    </body>
</html>