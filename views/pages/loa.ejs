<!DOCTYPE html>

<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy LOA</title>
    </head>
    <body>
        <header>
            <%- include('../partials/nav') %>
        </header>
        <main>
            <section class="profile-page">
                <div class="profile-heading">
                    <p class="profile-eyebrow">Leave of absence</p>
                    <h1>Leave of Absence</h1>
                    <p class="profile-subtitle">Apply for time off and track the status of your requests.</p>
                    <% if (typeof canViewLoaHistory !== 'undefined' && canViewLoaHistory) { %>
                    <p><a class="action-button action-button-primary" href="/loa/history"><span class="material-symbols-outlined" aria-hidden="true">history</span>View LOA history</a></p>
                    <% } %>
                </div>
                <div class="profile-details">
                    <div class="profile-detail-full">
                        <span>Apply for Leave</span>
                        <form class="login-form-actions" action="/apply-loa" method="POST">
                            <label for="startDate">Start Date:</label>
                            <input type="date" id="startDate" name="startDate" required>

                            <label for="endDate">End Date:</label>
                            <input type="date" id="endDate" name="endDate" required>

                            <label for="reason">Reason:</label>
                            <textarea id="reason" name="reason" rows="3" required></textarea>

                            <button type="submit">Submit Request</button>
                        </form>
                    </div>

                    <div class="profile-detail-full">
                        <span>Your LOA History</span>
                        <% if (loaHistory.length === 0) { %>
                        <strong>No LOA requests on record</strong>
                        <% } else { %>
                        <ul class="strikes-list">
                            <% loaHistory.forEach(function(request) { %>
                            <li>
                                <strong><%= request.startDate %> to <%= request.endDate %></strong> - <%= request.reason %>
                                <br>
                                <small class="status-badge status-<%= request.status.toLowerCase() %>"><%= request.status %></small>
                                <small><%= (request.requestedAt || '').slice(0, 10) %></small>
                            </li>
                            <% }); %>
                        </ul>
                        <% } %>
                    </div>

                    <% if (typeof canManageLoa !== 'undefined' ? canManageLoa : (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userType === 'Dreamy Defender' || userIsDeveloper)) { %>
                    <div class="profile-detail-full">
                        <span>Place Staff on LOA (Admin Action)</span>
                        <form class="login-form-actions" action="/admin/place-loa" method="POST">
                            <label for="adminTargetDiscordId">Select Staff Member:</label>
                            <select id="adminTargetDiscordId" name="targetDiscordId" required>
                                <option value="" disabled selected>-- Select a staff member --</option>
                                <% (typeof staffUsers !== 'undefined' ? staffUsers : []).forEach(function(staff) { %>
                                <option value="<%= staff.login.discordId %>">
                                    <%= staff.displayName || staff.discordUser %> (<%= staff.accountType || 'Staff' %>)
                                </option>
                                <% }); %>
                            </select>

                            <label for="adminStartDate">Start Date:</label>
                            <input type="date" id="adminStartDate" name="startDate" required>

                            <label for="adminEndDate">End Date:</label>
                            <input type="date" id="adminEndDate" name="endDate" required>

                            <label for="adminReason">Reason / Notes:</label>
                            <textarea id="adminReason" name="reason" rows="3" placeholder="Reason for placing this staff member on LOA..." required></textarea>

                            <div style="display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 20px;">
                                <input type="checkbox" id="adminAutoApprove" name="autoApprove" value="true" checked style="width: auto; margin: 0; cursor: pointer;">
                                <label for="adminAutoApprove" style="margin: 0; font-size: 0.95em; cursor: pointer; color: var(--space-angel); font-weight: normal;">Immediately approve this LOA</label>
                            </div>

                            <button type="submit">Place Staff on LOA</button>
                        </form>
                    </div>

                    <% if (typeof activeLoaUsers !== 'undefined' && activeLoaUsers && activeLoaUsers.length) { %>
                    <div class="profile-detail-full">
                        <span>Currently on LOA (<%= activeLoaUsers.length %> Staff)</span>
                        <ul class="strikes-list">
                            <% activeLoaUsers.forEach(function(activeReq) { %>
                            <li>
                                <strong><%= activeReq.displayName %></strong> <small>(<%= activeReq.accountType || 'Staff' %>)</small>: <%= activeReq.startDate %> to <%= activeReq.endDate %> - <%= activeReq.reason %>
                                <br>
                                <small class="status-badge status-approved">Active LOA</small>
                                <% if (activeReq.placedByAdmin) { %><small>· Placed by admin</small><% } %>
                                <form action="/admin/end-loa" method="POST" data-name="<%= activeReq.displayName %>" onsubmit="return confirm('End LOA early for ' + this.dataset.name + '?');" style="display: inline-block; margin-top: 6px;">
                                    <input type="hidden" name="discordId" value="<%= activeReq.discordId %>">
                                    <input type="hidden" name="requestId" value="<%= activeReq.id %>">
                                    <button type="submit" style="padding: 4px 10px; font-size: 0.85em; background-color: #ef4444; color: #fff;">End LOA Early</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                    </div>
                    <% } %>

                    <div class="profile-detail-full">
                        <span>Pending LOA Requests</span>
                        <% if (pendingRequests.length === 0) { %>
                        <strong>No pending LOA requests</strong>
                        <% } else { %>
                        <ul class="strikes-list">
                            <% pendingRequests.forEach(function(request) { %>
                            <li>
                                <strong><%= request.displayName %></strong>: <%= request.startDate %> to <%= request.endDate %> - <%= request.reason %>
                                <br>
                                <form action="/review-loa" method="POST">
                                    <input type="hidden" name="discordId" value="<%= request.discordId %>">
                                    <input type="hidden" name="requestId" value="<%= request.id %>">
                                    <button type="submit" name="decision" value="Approved">Approve</button>
                                    <button type="submit" name="decision" value="Denied">Deny</button>
                                </form>
                            </li>
                            <% }); %>
                        </ul>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </section>
        </main>
        <div class="footer">
            <p>&copy; 2026 Drowsy Vocals | All rights reserved.</p>
        </div>
    </body>
</html>