<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/head') %>
        <title>Drowsy Vocals</title>
    </head>
    <body class="splash-page<%= seasonalTheme === 'halloween' ? ' halloween-login-page' : (seasonalTheme === 'christmas' ? ' christmas-login-page' : '') %>">
        <main class="splash" aria-labelledby="splashTitle">
            <img class="splash-logo" src="/assets/drowsyNew.png" alt="Drowsy Vocals">
            <p id="splashTitle">Welcome to Drowsy Vocals</p>
        </main>
        <script>
            (() => {
                const destination = '/index?splash=1';
                window.setTimeout(() => {
                    document.body.classList.add('splash-leaving');
                    window.setTimeout(() => window.location.replace(destination), 350);
                }, 1800);
            })();
        </script>
    </body>
</html>
