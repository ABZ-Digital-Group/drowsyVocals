                    </select>
                    <br>

                    <label for="strikeReason">Reason:</label>
                    <textarea id="strikeReason" name="reason" rows="3" required></textarea>

                    <div class="dialog-buttons">
                        <button type="submit">Issue Strike</button>
                        <button type="button" id="closeAddStrikePopup">Cancel</button>
                    </div>
                </form>
                <hr>
                <p><b>Existing Strikes</b></p>
