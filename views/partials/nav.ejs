<% if (typeof maintenanceActive !== 'undefined' && maintenanceActive) { %>
<div class="maintenance-admin-banner">
    <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1.2em;">construction</span>
    <span>Maintenance mode is currently ACTIVE. Regular users cannot access the site.</span>
    <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper) { %>
    <a href="/settings">Manage in Settings</a>
    <% } %>
</div>
<% } %>
<% if (typeof developerPreviewMode !== 'undefined' && developerPreviewMode) { %>
<div class="developer-preview-banner" role="status">
    <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
    <span>You are viewing the site as a non-admin user.</span>
    <form method="post" action="/developer-preview/stop">
        <button type="submit">Exit preview</button>
    </form>
</div>
<% } %>
<nav>
    <img src="/assets/drowsyNew.png" alt="Drowsy Vocals Logo">
    <button class="nav-menu-toggle" type="button" aria-expanded="false" aria-controls="primaryNavigation"><span class="material-symbols-outlined" aria-hidden="true">menu</span> Menu</button>
    <ul id="primaryNavigation">
        <% if (canViewPage('dashboard')) { %><li><a href="/dashboard">Dashboard</a></li><% } %>
        <% if (canViewPage('roster')) { %><li><a href="/roster">Roster</a></li><% } %>
        <% if (canViewPage('events') || canViewPage('brackets')) { %>
        <li class="nav-events-menu">
            <% if (canViewPage('events')) { %><a href="/events">Events <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span></a><% } %>
            <div class="nav-guidelines-dropdown nav-events-dropdown">
                <% if (canViewPage('brackets')) { %><a href="/brackets">Brackets</a><% } %>
            </div>
        </li>
        <% } %>
        <% if (canViewPage('house-points')) { %><li><a href="/house-points">House Points</a></li><% } %>
        <% if (canViewPage('bingo')) { %><li><a href="/bingo">Bingo</a></li><% } %>
        <% if (canViewPage('loa') || canViewPage('feedback')) { %>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="guidelinesMenu">
                Forms
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="guidelinesMenu">
                <% if (canViewPage('loa')) { %><a href="/loa">LOA</a><% } %>
                <% if (canViewPage('feedback')) { %><a href="/feedback">Feedback</a><% } %>
                <a href="https://drowsyvocals.com/feedback.html">Event Feedback</a>
            </div>
        </li>
        <% } %>
        <% if (canViewPage('staff-guidelines') || canViewPage('community-host-guidelines') || canViewPage('higher-guidelines')) { %>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="guidelinesMenu">
                Guidelines
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="guidelinesMenu">
                <% if (canViewPage('staff-guidelines')) { %><a href="/staff-guidelines">Staff Guidelines</a><% } %>
                <% if (canViewPage('community-host-guidelines')) { %><a href="/community-host-guidelines">Community Host Guidelines</a><% } %>
                <% if (canViewPage('higher-guidelines') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/higher-guidelines">Higher Guidelines</a><% } %>
            </div>
        </li>
        <% } %>
        <% if (
            ((userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)
                && (canViewPage('applications') || canViewPage('appeals') || canViewPage('check-ins')
                    || canViewPage('loa-history') || canViewPage('roster-planner') || canViewPage('reports')
                    || canViewPage('staff-activity') || canViewPage('analytics') || canViewPage('audit-log') || canViewPage('changelog')
                    || canViewPage('footprint') || canViewPage('bot')))
            || (canViewPage('discord-channels') && currentuser === '404371787606917140' && !developerPreviewMode)
        ) { %>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="managementMenu">
                Management
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="managementMenu">
                <% if (canViewPage('applications') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/applications">Applications</a><% } %>
                <% if (canViewPage('appeals') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/appeals">Strike Appeals</a><% } %>
                <% if (canViewPage('check-ins') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/check-ins">Check-ins</a><% } %>
                <% if (canViewPage('loa-history') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/loa/history">LOA History</a><% } %>
                <% if (canViewPage('roster-planner') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/roster-planner">Roster Planner</a><% } %>
                <% if (canViewPage('reports') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/reports">Reports</a><% } %>
                <% if (canViewPage('staff-activity') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/staff-activity">Staff Activity</a><% } %>
                <% if (canViewPage('analytics') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/analytics">Server Analytics</a><% } %>
                <% if (canViewPage('audit-log') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/audit-log">Audit Log</a><% } %>
                <% if (canViewPage('changelog') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/changelog">Changelog</a><% } %>
                <% if (canViewPage('footprint') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper)) { %><a href="/footprint">Digital Footprint</a><% } %>
                <% if (canViewPage('discord-channels') && currentuser === '404371787606917140' && !developerPreviewMode) { %><a href="/discord-channels">Discord Channels</a><% } %>
                <% if (canViewPage('bot') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper)) { %><a href="/bot">Discord Bot</a><% } %>
            </div>
        </li>
        <% } %>
        <% if (canViewPage('notifications')) { %>
        <li class="nav-notifications-menu">
            <button class="nav-notifications-trigger" type="button" aria-expanded="false" aria-controls="notificationsMenu" aria-label="Notifications">
                <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
                <% if (typeof notifications !== 'undefined' && notifications.length) { %><span class="nav-notification-count"><%= notifications.length %></span><% } %>
            </button>
            <div class="nav-notifications-dropdown" id="notificationsMenu">
                <% if (typeof notifications !== 'undefined' && notifications.length) { %><% notifications.forEach(function(notification) { %><a href="<%= notification.href %>"><%= notification.text %></a><% }); %><% } else { %><span>All caught up.</span><% } %>
                <a href="/notifications">View notification history</a>
            </div>
        </li>
        <% } %>
        <% if (canViewPage('account')) { %>
        <li class="nav-account-menu">
            <button class="nav-account-trigger" type="button" aria-expanded="false" aria-controls="accountMenu">
                <% if (navUser && navUser.avatarUrl) { %>
                <img src="<%= navUser.avatarUrl %>" alt="" class="nav-account-avatar" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='grid';">
                <span class="nav-account-avatar nav-account-initial" style="display: none;"><%= navUser ? navUser.displayName.charAt(0).toUpperCase() : '?' %></span>
                <% } else { %>
                <span class="nav-account-avatar nav-account-initial"><%= navUser ? navUser.displayName.charAt(0).toUpperCase() : '?' %></span>
                <% } %>
                <span class="nav-account-name"><%= navUser ? navUser.displayName : currentuser %></span>
                <span class="material-symbols-outlined nav-account-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-account-dropdown" id="accountMenu">
                <a href="/account">Account</a>
                <button type="button" class="nav-account-action theme-toggle" data-theme-toggle aria-pressed="false">
                    <span class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
                    <span data-theme-label>Dark mode</span>
                </button>
                <% if ((userIsDeveloper || userType === 'Mr. Sandman' || userType === 'Realm God') && !developerPreviewMode) { %>
                <form method="post" action="/developer-preview/start">
                    <button type="submit" class="nav-account-action">User view</button>
                </form>
                <% } %>
                <% if (canViewPage('settings') && (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper)) { %>
                <a href="/settings">Settings</a>
                <% if (canViewPage('bot')) { %><a href="/bot">Discord Bot</a><% } %>
                <% } %>
                <a href="/logout">Logout</a>
            </div>
        </li>
        <% } %>
    </ul>
</nav>
