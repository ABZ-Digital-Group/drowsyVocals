<% if (typeof maintenanceActive !== 'undefined' && maintenanceActive) { %>
<div class="maintenance-admin-banner">
    <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 1.2em;">construction</span>
    <span>Maintenance mode is currently ACTIVE. Regular users cannot access the site.</span>
    <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper) { %>
    <a href="/settings">Manage in Settings</a>
    <% } %>
</div>
<% } %>
<nav>
    <img src="/assets/DrowsyLogo.png" alt="Drowsy Vocals Logo">
    <button class="nav-menu-toggle" type="button" aria-expanded="false" aria-controls="primaryNavigation"><span class="material-symbols-outlined" aria-hidden="true">menu</span> Menu</button>
    <ul id="primaryNavigation">
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/roster">Roster</a></li>
        <li><a href="/bingo">Bingo</a></li>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="guidelinesMenu">
                Forms
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="guidelinesMenu">
                <a href="/loa">LOA</a>
                <a href="/feedback">Feedback</a>
            </div>
        </li>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="guidelinesMenu">
                Guidelines
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="guidelinesMenu">
                <a href="/staff-guidelines">Staff Guidelines</a>
                <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper) { %>
                <a href="/higher-guidelines">Higher Guidelines</a>
                <% } %>
            </div>
        </li>
        <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userType === 'Drowsy Defender' || userIsDeveloper) { %>
        <li class="nav-guidelines-menu">
            <button class="nav-guidelines-trigger" type="button" aria-expanded="false" aria-controls="managementMenu">
                Management
                <span class="material-symbols-outlined nav-guidelines-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-guidelines-dropdown" id="managementMenu">
                <a href="/applications">Applications</a>
                <a href="/roster-planner">Roster Planner</a>
                <a href="/reports">Reports</a>
                <a href="/audit-log">Audit Log</a>
            </div>
        </li>
        <% } %>
        <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper) { %>
        <% } %>
        <li class="nav-notifications-menu">
            <button class="nav-notifications-trigger" type="button" aria-expanded="false" aria-controls="notificationsMenu" aria-label="Notifications">
                <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
                <% if (notifications && notifications.length) { %><span class="nav-notification-count"><%= notifications.length %></span><% } %>
            </button>
            <div class="nav-notifications-dropdown" id="notificationsMenu">
                <% if (notifications && notifications.length) { %><% notifications.forEach(function(notification) { %><a href="<%= notification.href %>"><%= notification.text %></a><% }); %><% } else { %><span>All caught up.</span><% } %>
            </div>
        </li>
        <li class="nav-account-menu">
            <button class="nav-account-trigger" type="button" aria-expanded="false" aria-controls="accountMenu">
                <% if (navUser && navUser.avatarUrl) { %>
                <img src="<%= navUser.avatarUrl %>" alt="" class="nav-account-avatar">
                <% } else { %>
                <span class="nav-account-avatar nav-account-initial"><%= navUser ? navUser.displayName.charAt(0).toUpperCase() : '?' %></span>
                <% } %>
                <span class="nav-account-name"><%= navUser ? navUser.displayName : currentuser %></span>
                <span class="material-symbols-outlined nav-account-arrow" aria-hidden="true">expand_more</span>
            </button>
            <div class="nav-account-dropdown" id="accountMenu">
                <a href="/account">Account</a>
                <% if (userType === 'Mr. Sandman' || userType === 'Realm God' || userIsDeveloper) { %>
                <a href="/settings">Settings</a>
                <% } %>
                <a href="/logout">Logout</a>
            </div>
        </li>
    </ul>
</nav>
